# Normalise line endings.
#
# WHY THIS FILE EXISTS: core.autocrlf differs from machine to machine. Without
# it, one person commits and everyone sees "the whole file changed" purely
# because of CRLF vs LF, and merges conflict on lines nobody actually touched.

* text=auto eol=crlf

# Files that only ever run on Unix (GitHub Actions uses bash) must keep LF
*.sh text eol=lf

# Shared git hooks (core.hooksPath=.githooks) are POSIX shell scripts invoked
# directly by git; a CRLF-terminated shebang line breaks them the same way a
# .sh file would.
.githooks/* text eol=lf

# Binary - never touch the contents
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.dll  binary
*.exe  binary
*.snk  binary
*.bak  binary

# GitHub language statistics
*.sql linguist-detectable=true
docs/* linguist-documentation=true
db/data/** linguist-generated=true
