<UserControl x:Class="App.Views.Catalog.TermAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Quản Lý Kỳ Học" Style="{StaticResource PageTitleStyle}" />
                    <!-- The distinction is spelled out here because a "Kỳ học" menu next to
                         "Học kỳ" is otherwise easy to mistake for the same screen. -->
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"
                               Text="Các kỳ của CHƯƠNG TRÌNH ĐÀO TẠO (Kỳ 0 - Kỳ 9), dùng để xếp môn học vào chương trình. Khác với 'Học kỳ theo lịch' (FA25, SP26) dùng để ghi nhận điểm." />
                </StackPanel>
                <Button Content="+ Thêm kỳ học" Command="{Binding OpenCreateEditorCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" ToolTip="Tìm theo số kỳ hoặc tên kỳ">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Tìm kiếm" Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Content="Xóa lọc" Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2">
                <Border Style="{StaticResource StatusBannerStyle}"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}"
                               FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          Style="{StaticResource CatalogDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                          CellStyle="{StaticResource CatalogCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Số kỳ" Binding="{Binding TermNo}" Width="90" />
                        <DataGridTextColumn Header="Tên kỳ" Binding="{Binding TermName}" Width="220" />
                        <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="Số môn" Binding="{Binding SubjectCount}" Width="100" />
                        <DataGridTemplateColumn Header="Trạng thái" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChipBorderStyle}" HorizontalAlignment="Left">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ChipTextStyle}">
                                                    <Setter Property="Text" Value="Ngừng hoạt động" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Đang hoạt động" />
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Thao tác" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Sửa"
                                                Command="{Binding DataContext.OpenEditEditorCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallActionButtonStyle}" />
                                        <Button Content="Đổi trạng thái"
                                                Command="{Binding DataContext.ToggleActiveCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallActionButtonStyle}"
                                                Background="{StaticResource SecondaryBrush}" Margin="6,0,0,0" />
                                        <Button Content="Xóa"
                                                Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallActionButtonStyle}"
                                                Background="{StaticResource DangerBrush}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{StaticResource CardBrush}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📅" FontSize="42" HorizontalAlignment="Center" />
                        <TextBlock Text="Chưa có kỳ học nào" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,10,0,4" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#CCFFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6"
                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                 Foreground="{StaticResource PrimaryBrush}" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <TextBlock Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Run Text="Tổng" /><Run Text=" " /><Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text="kỳ · Trang" /><Run Text=" " /><Run Text="{Binding PageNumber, Mode=OneWay}" />
                    <Run Text="/" /><Run Text="{Binding PageCount, Mode=OneWay}" />
                </TextBlock>
                <Button Content="◀ Trước" Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource GhostButtonStyle}" />
                <Button Content="Sau ▶" Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalPanelStyle}">
                <StackPanel>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
                                <Setter Property="Text" Value="Cập nhật kỳ học" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                        <Setter Property="Text" Value="Thêm kỳ học mới" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Số kỳ * (0 - 12, Kỳ 0 là kỳ định hướng)"
                               Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4" />
                    <TextBox Text="{Binding EditTermNo, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" />

                    <TextBlock Text="Tên kỳ" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding EditTermName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" MaxLength="50" />

                    <TextBlock Text="Mô tả" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogMultilineTextBoxStyle}" MaxLength="500" />

                    <CheckBox Content="Đang hoạt động" IsChecked="{Binding EditIsActive}"
                              Style="{StaticResource CatalogCheckBoxStyle}" Margin="0,14,0,0" />

                    <Border Style="{StaticResource ErrorBannerStyle}" Margin="0,12,0,0"
                            Visibility="{Binding HasEditorError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding EditorErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Hủy" Command="{Binding CloseEditorCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Lưu" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" MinWidth="110" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
