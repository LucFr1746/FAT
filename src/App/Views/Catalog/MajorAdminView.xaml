<UserControl x:Class="App.Views.Catalog.MajorAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Quản Lý Ngành Học" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"
                               Text="Thêm, sửa và ngừng hoạt động các ngành đào tạo. Tổng số tín chỉ được tính tự động từ chương trình học." />
                </StackPanel>
                <Button Content="+ Thêm ngành"
                        Command="{Binding OpenCreateEditorCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <!-- Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}"
                             ToolTip="Tìm theo mã hoặc tên ngành">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1" Content="Tìm kiếm" Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Content="Xóa lọc" Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
                    <CheckBox Grid.Column="3" Content="Hiện cả ngành đã ngừng"
                              IsChecked="{Binding ShowInactive}"
                              Command="{Binding ToggleShowInactiveCommand}"
                              Style="{StaticResource CatalogCheckBoxStyle}" Margin="14,0,0,0" />
                </Grid>
            </Border>

            <!-- Banners -->
            <StackPanel Grid.Row="2">
                <Border Style="{StaticResource StatusBannerStyle}"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}"
                               FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- Grid -->
            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          Style="{StaticResource CatalogDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                          CellStyle="{StaticResource CatalogCellStyle}"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã ngành" Binding="{Binding MajorCode}" Width="130" />
                        <DataGridTextColumn Header="Tên ngành" Binding="{Binding MajorName}" Width="*" MinWidth="200" />
                        <DataGridTextColumn Header="Tín chỉ tốt nghiệp" Binding="{Binding RequiredCredits}" Width="150" />
                        <DataGridTextColumn Header="Số kỳ" Binding="{Binding TotalTerms}" Width="80" />
                        <DataGridTemplateColumn Header="Trạng thái" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChipBorderStyle}" HorizontalAlignment="Left">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ChipTextStyle}">
                                                    <Setter Property="Text" Value="Ngừng hoạt động" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Đang hoạt động" />
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Thao tác" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Sửa"
                                                Command="{Binding DataContext.OpenEditEditorCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallActionButtonStyle}" />
                                        <Button Content="Ngừng"
                                                Command="{Binding DataContext.DeactivateCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallActionButtonStyle}"
                                                Background="{StaticResource DangerBrush}"
                                                Margin="6,0,0,0"
                                                IsEnabled="{Binding IsActive}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <Border Background="{StaticResource CardBrush}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🎓" FontSize="42" HorizontalAlignment="Center" />
                        <TextBlock Text="Chưa có ngành học nào" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,10,0,4" HorizontalAlignment="Center" />
                        <TextBlock Text="Hãy thêm ngành mới hoặc import dữ liệu từ FLM."
                                   Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Loading state -->
                <Border Background="#CCFFFFFF"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="6"
                                     Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="Đang tải dữ liệu..." Style="{StaticResource PageSubtitleStyle}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pagination -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <TextBlock Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Run Text="Tổng" /><Run Text=" " /><Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text="ngành · Trang" /><Run Text=" " /><Run Text="{Binding PageNumber, Mode=OneWay}" />
                    <Run Text="/" /><Run Text="{Binding PageCount, Mode=OneWay}" />
                </TextBlock>
                <Button Content="◀ Trước" Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource GhostButtonStyle}" />
                <Button Content="Sau ▶" Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ===================== Editor modal ===================== -->
        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalPanelStyle}">
                <StackPanel>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
                                <Setter Property="Text" Value="Cập nhật ngành học" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                        <Setter Property="Text" Value="Thêm ngành học mới" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Mã ngành *" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4" />
                    <TextBox Text="{Binding EditMajorCode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" MaxLength="20" />

                    <TextBlock Text="Tên ngành *" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding EditMajorName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" MaxLength="150" />

                    <TextBlock Text="Số kỳ của chương trình" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                    <!-- IsReadOnly: TotalTerms is recomputed from the curriculum on
                         every save, so an editable box here would accept a value and
                         silently discard it. -->
                    <TextBox Text="{Binding EditTotalTerms, Mode=OneWay}" IsReadOnly="True"
                             Style="{StaticResource CatalogTextBoxStyle}" />

                    <CheckBox Content="Đang hoạt động" IsChecked="{Binding EditIsActive}"
                              Style="{StaticResource CatalogCheckBoxStyle}" Margin="0,14,0,0" />

                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,10,0,0"
                               Text="Tổng số tín chỉ tốt nghiệp và số kỳ được tính tự động từ danh sách môn học trong chương trình, không nhập tay." />

                    <Border Style="{StaticResource ErrorBannerStyle}" Margin="0,12,0,0"
                            Visibility="{Binding HasEditorError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding EditorErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Hủy" Command="{Binding CloseEditorCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Lưu" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" MinWidth="110" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
