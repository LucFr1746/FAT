<UserControl x:Class="App.Views.Catalog.SemesterAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Quản Lý Học Kỳ Theo Lịch" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"
                               Text="Các học kỳ thực tế (FA25, SP26...) dùng để ghi nhận lượt đăng ký và điểm. Chỉ có duy nhất một học kỳ được đánh dấu là hiện tại." />
                </StackPanel>
                <Button Content="+ Thêm học kỳ" Command="{Binding OpenCreateEditorCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" ToolTip="Tìm theo mã hoặc tên học kỳ">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Tìm kiếm" Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Content="Xóa lọc" Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2">
                <Border Style="{StaticResource StatusBannerStyle}"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}"
                               FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          Style="{StaticResource CatalogDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                          CellStyle="{StaticResource CatalogCellStyle}"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Thứ tự" Binding="{Binding DisplayOrder}" Width="90" />
                        <DataGridTextColumn Header="Mã" Binding="{Binding SemesterCode}" Width="110" />
                        <DataGridTextColumn Header="Tên học kỳ" Binding="{Binding SemesterName}" Width="*" MinWidth="180" />
                        <DataGridTextColumn Header="Bắt đầu" Width="130"
                                            Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" />
                        <DataGridTextColumn Header="Kết thúc" Width="130"
                                            Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" />
                        <DataGridTemplateColumn Header="Hiện tại" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChipBorderStyle}" HorizontalAlignment="Left"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="● Hiện tại" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Thao tác" Width="230">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Sửa"
                                                Command="{Binding DataContext.OpenEditEditorCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallActionButtonStyle}" />
                                        <Button Content="Đặt hiện tại"
                                                Command="{Binding DataContext.SetCurrentCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallActionButtonStyle}"
                                                Background="{StaticResource SecondaryBrush}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{StaticResource CardBrush}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🗓️" FontSize="42" HorizontalAlignment="Center" />
                        <TextBlock Text="Chưa có học kỳ nào" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,10,0,4" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#CCFFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6"
                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                 Foreground="{StaticResource PrimaryBrush}" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <TextBlock Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Run Text="Tổng" /><Run Text=" " /><Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text="học kỳ · Trang" /><Run Text=" " /><Run Text="{Binding PageNumber, Mode=OneWay}" />
                    <Run Text="/" /><Run Text="{Binding PageCount, Mode=OneWay}" />
                </TextBlock>
                <Button Content="◀ Trước" Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource GhostButtonStyle}" />
                <Button Content="Sau ▶" Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalPanelStyle}">
                <StackPanel>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
                                <Setter Property="Text" Value="Cập nhật học kỳ" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                        <Setter Property="Text" Value="Thêm học kỳ mới" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã học kỳ *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding EditSemesterCode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CatalogTextBoxStyle}" MaxLength="10" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Thứ tự thời gian *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding EditDisplayOrder, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CatalogTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Tên học kỳ *" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding EditSemesterName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" MaxLength="50" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ngày bắt đầu *" Style="{StaticResource FieldLabelStyle}" />
                            <DatePicker SelectedDate="{Binding EditStartDate}" MinHeight="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ngày kết thúc *" Style="{StaticResource FieldLabelStyle}" />
                            <DatePicker SelectedDate="{Binding EditEndDate}" MinHeight="40" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,12,0,0"
                               Text="Thứ tự thời gian quyết định thứ tự hiển thị của biểu đồ GPA - không sắp xếp theo mã học kỳ vì 'FA25' đứng trước 'SP26' theo bảng chữ cái nhưng lại diễn ra trước." />

                    <Border Style="{StaticResource ErrorBannerStyle}" Margin="0,12,0,0"
                            Visibility="{Binding HasEditorError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding EditorErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Hủy" Command="{Binding CloseEditorCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Lưu" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" MinWidth="110" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
