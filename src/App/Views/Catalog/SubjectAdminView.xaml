<UserControl x:Class="App.Views.Catalog.SubjectAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1220">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- The active detail tab is highlighted; the rest read as plain links. -->
        <Style x:Key="DetailTabButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Quản Lý Môn Học" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"
                               Text="Mỗi môn học gồm thông tin chung, tài liệu, bảng cấu trúc điểm và lịch kiểm tra dự kiến. Kỳ học của môn được xác định trong từng chương trình đào tạo, không cố định trên môn." />
                </StackPanel>
                <Button Content="+ Thêm môn học" Command="{Binding OpenCreateEditorCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <!-- Filters -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" ToolTip="Tìm theo mã hoặc tên môn học">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding Majors}"
                              SelectedItem="{Binding SelectedMajorFilter}"
                              DisplayMemberPath="MajorCode"
                              Style="{StaticResource CatalogComboBoxStyle}"
                              Margin="10,0,0,0" ToolTip="Lọc theo ngành" />

                    <ComboBox Grid.Column="2" ItemsSource="{Binding TermOptions}"
                              SelectedItem="{Binding SelectedTermFilter}"
                              DisplayMemberPath="Display"
                              Style="{StaticResource CatalogComboBoxStyle}"
                              Margin="10,0,0,0" ToolTip="Lọc theo kỳ" />

                    <Button Grid.Column="3" Content="Lọc" Command="{Binding ApplyFiltersCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" />
                    <Button Grid.Column="4" Content="Đặt lại" Command="{Binding ResetFiltersCommand}"
                            Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
                    <CheckBox Grid.Column="5" Content="Hiện môn đã ngừng"
                              IsChecked="{Binding ShowInactive}"
                              Command="{Binding ToggleShowInactiveCommand}"
                              Style="{StaticResource CatalogCheckBoxStyle}" Margin="14,0,0,0" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2">
                <Border Style="{StaticResource StatusBannerStyle}"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}"
                               FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          Style="{StaticResource CatalogDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                          CellStyle="{StaticResource CatalogCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã môn" Binding="{Binding CourseCode}" Width="110" />
                        <DataGridTextColumn Header="Tên môn học" Binding="{Binding CourseName}" Width="*" />
                        <DataGridTextColumn Header="Tín chỉ" Binding="{Binding Credits}" Width="80" />
                        <DataGridTextColumn Header="Tính GPA" Binding="{Binding GpaDisplay}" Width="90" />
                        <DataGridTextColumn Header="Tiên quyết" Binding="{Binding PrerequisiteCount}" Width="90" />
                        <DataGridTextColumn Header="Tài liệu" Binding="{Binding MaterialCount}" Width="80" />
                        <DataGridTextColumn Header="Cột điểm" Binding="{Binding AssessmentCount}" Width="90" />
                        <DataGridTemplateColumn Header="Thao tác" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Chi tiết"
                                                Command="{Binding DataContext.OpenDetailsCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallActionButtonStyle}"
                                                Background="{StaticResource SecondaryBrush}" />
                                        <Button Content="Sửa"
                                                Command="{Binding DataContext.OpenEditEditorCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallActionButtonStyle}" Margin="6,0,0,0" />
                                        <Button Content="Ngừng"
                                                Command="{Binding DataContext.DeactivateCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallActionButtonStyle}"
                                                Background="{StaticResource DangerBrush}" Margin="6,0,0,0"
                                                IsEnabled="{Binding IsActive}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{StaticResource CardBrush}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📚" FontSize="42" HorizontalAlignment="Center" />
                        <TextBlock Text="Không tìm thấy môn học nào" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,10,0,4" HorizontalAlignment="Center" />
                        <TextBlock Text="Thử đổi bộ lọc, hoặc import dữ liệu từ FLM."
                                   Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#CCFFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6"
                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                 Foreground="{StaticResource PrimaryBrush}" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <TextBlock Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Run Text="Tổng" /><Run Text=" " /><Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text="môn · Trang" /><Run Text=" " /><Run Text="{Binding PageNumber, Mode=OneWay}" />
                    <Run Text="/" /><Run Text="{Binding PageCount, Mode=OneWay}" />
                </TextBlock>
                <Button Content="◀ Trước" Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource GhostButtonStyle}" />
                <Button Content="Sau ▶" Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ===================== Subject editor ===================== -->
        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalPanelStyle}" MaxWidth="640">
                <StackPanel>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
                                <Setter Property="Text" Value="Cập nhật môn học" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                        <Setter Property="Text" Value="Thêm môn học mới" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã môn học *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding EditCourseCode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CatalogTextBoxStyle}" MaxLength="20" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tín chỉ *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding EditCredits, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CatalogTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Tên môn học *" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding EditCourseName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" MaxLength="200" />

                    <TextBlock Text="Mô tả" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogMultilineTextBoxStyle}" />

                    <TextBlock Text="Môn tiên quyết (mô tả nguyên văn)" Style="{StaticResource FieldLabelStyle}"
                               Margin="0,12,0,4" />
                    <TextBox Text="{Binding EditPrerequisiteText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" MaxLength="500"
                             ToolTip="Ví dụ: PRF192  |  MLN111, MLN122  |  MGT101 or MKG101" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <CheckBox Content="Tính vào GPA" IsChecked="{Binding EditCountsTowardGpa}"
                                  Style="{StaticResource CatalogCheckBoxStyle}" />
                        <CheckBox Content="Đang hoạt động" IsChecked="{Binding EditIsActive}"
                                  Style="{StaticResource CatalogCheckBoxStyle}" Margin="24,0,0,0" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,10,0,0"
                               Text="Bỏ chọn 'Tính vào GPA' cho các môn như GDTC hay Định hướng: vẫn tính tín chỉ và vẫn phải qua môn, nhưng điểm không đưa vào GPA." />

                    <Border Style="{StaticResource ErrorBannerStyle}" Margin="0,12,0,0"
                            Visibility="{Binding HasEditorError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding EditorErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Hủy" Command="{Binding CloseEditorCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Lưu" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" MinWidth="110" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================== Detail panel ===================== -->
        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalPanelStyle}" MaxWidth="980" MinWidth="860" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="380" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,18"
                            CornerRadius="16,16,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0">
                                    <Run Text="{Binding DetailCourse.CourseCode, Mode=OneWay}" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding DetailCourse.CourseName, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0">
                                    <Run Text="{Binding DetailCourse.Credits, Mode=OneWay}" />
                                    <Run Text="tín chỉ · Tính GPA:" />
                                    <Run Text="{Binding DetailCourse.GpaDisplay, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Content="✕" Command="{Binding CloseDetailsCommand}"
                                    Style="{StaticResource GhostButtonStyle}" MinWidth="44"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <!-- Tabs -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,16,24,0">
                        <Button Content="Tài liệu" Command="{Binding SwitchDetailTabCommand}"
                                CommandParameter="Materials" Style="{StaticResource DetailTabButtonStyle}" />
                        <Button Content="Cấu trúc điểm" Command="{Binding SwitchDetailTabCommand}"
                                CommandParameter="GradeStructure" Style="{StaticResource DetailTabButtonStyle}" />
                        <Button Content="Lịch kiểm tra" Command="{Binding SwitchDetailTabCommand}"
                                CommandParameter="Schedule" Style="{StaticResource DetailTabButtonStyle}" />
                    </StackPanel>

                    <!-- Banners -->
                    <StackPanel Grid.Row="2" Margin="24,14,24,0">
                        <Border Style="{StaticResource ErrorBannerStyle}" Margin="0"
                                Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DetailErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                       FontWeight="Bold" TextWrapping="Wrap" />
                        </Border>
                        <!-- An unbalanced structure is silent at run time: it just
                             caps the subject's final score. This banner is the only
                             place it surfaces. -->
                        <Border Style="{StaticResource InfoBannerStyle}" Margin="0,8,0,0"
                                Visibility="{Binding HasGradeStructureWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="{StaticResource TextBrush}" FontWeight="Bold" TextWrapping="Wrap">
                                <Run Text="⚠ Tổng trọng số các cột điểm hiện là" />
                                <Run Text="{Binding GradeStructureValidation.TotalWeightPercent, Mode=OneWay}" />
                                <Run Text="%, phải bằng 100% thì điểm tổng kết mới đúng." />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Materials -->
                    <Grid Grid.Row="3" Margin="24,14,24,0"
                          Visibility="{Binding IsMaterialsTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="+ Thêm tài liệu" Command="{Binding OpenCreateMaterialCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"
                                Margin="0,0,0,10" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Materials}"
                                  SelectedItem="{Binding SelectedMaterial}"
                                  Style="{StaticResource CatalogDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                                  CellStyle="{StaticResource CatalogCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="Đường dẫn" Binding="{Binding Url}" Width="260" />
                                <DataGridTemplateColumn Header="Thao tác" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Sửa"
                                                        Command="{Binding DataContext.OpenEditMaterialCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallActionButtonStyle}" />
                                                <Button Content="Xóa"
                                                        Command="{Binding DataContext.DeleteMaterialCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallActionButtonStyle}"
                                                        Background="{StaticResource DangerBrush}" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Grade structure -->
                    <Grid Grid.Row="3" Margin="24,14,24,0"
                          Visibility="{Binding IsGradeStructureTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="+ Thêm cột điểm" Command="{Binding OpenCreateGradeColumnCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center"
                                       Margin="14,0,0,0">
                                <Run Text="Tổng trọng số hiện tại:" />
                                <Run Text="{Binding GradeStructureValidation.TotalWeightPercent, Mode=OneWay}" />
                                <Run Text="% / 100%" />
                            </TextBlock>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding GradeColumns}"
                                  SelectedItem="{Binding SelectedGradeColumn}"
                                  Style="{StaticResource CatalogDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                                  CellStyle="{StaticResource CatalogCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên cột điểm" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Trọng số (%)" Binding="{Binding WeightPercent}" Width="130" />
                                <DataGridTextColumn Header="Điểm tối thiểu" Binding="{Binding MinScoreToPass}" Width="130" />
                                <DataGridTemplateColumn Header="Thao tác" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Sửa"
                                                        Command="{Binding DataContext.OpenEditGradeColumnCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallActionButtonStyle}" />
                                                <Button Content="Xóa"
                                                        Command="{Binding DataContext.DeleteGradeColumnCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallActionButtonStyle}"
                                                        Background="{StaticResource DangerBrush}" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Schedule -->
                    <Grid Grid.Row="3" Margin="24,14,24,0"
                          Visibility="{Binding IsScheduleTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="+ Thêm lịch kiểm tra" Command="{Binding OpenCreateScheduleItemCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center"
                                       Margin="14,0,0,0"
                                       Text="Dữ liệu FLM chỉ có số buổi, không có ngày. Hãy bổ sung ngày dự kiến khi đã có lịch học kỳ." />
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ScheduleItems}"
                                  SelectedItem="{Binding SelectedScheduleItem}"
                                  Style="{StaticResource CatalogDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                                  CellStyle="{StaticResource CatalogCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Buổi" Binding="{Binding SessionNo}" Width="70" />
                                <DataGridTextColumn Header="Tuần" Binding="{Binding WeekNo}" Width="70" />
                                <DataGridTextColumn Header="Nội dung" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="Ngày dự kiến" Width="130"
                                                    Binding="{Binding ExpectedDate, StringFormat=dd/MM/yyyy}" />
                                <DataGridTemplateColumn Header="Thao tác" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Sửa"
                                                        Command="{Binding DataContext.OpenEditScheduleItemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallActionButtonStyle}" />
                                                <Button Content="Xóa"
                                                        Command="{Binding DataContext.DeleteScheduleItemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallActionButtonStyle}"
                                                        Background="{StaticResource DangerBrush}" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" Padding="24,14"
                            CornerRadius="0,0,16,16">
                        <Button Content="Đóng" Command="{Binding CloseDetailsCommand}"
                                Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" />
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ===================== Material editor ===================== -->
        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding IsMaterialEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalPanelStyle}">
                <StackPanel>
                    <TextBlock Text="Tài liệu môn học" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="Tiêu đề *" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4" />
                    <TextBox Text="{Binding MaterialTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" MaxLength="500" />

                    <TextBlock Text="Mô tả" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding MaterialDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogMultilineTextBoxStyle}" />

                    <TextBlock Text="Đường dẫn (http hoặc https)" Style="{StaticResource FieldLabelStyle}"
                               Margin="0,12,0,4" />
                    <TextBox Text="{Binding MaterialUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" MaxLength="500" />

                    <Border Style="{StaticResource ErrorBannerStyle}" Margin="0,12,0,0"
                            Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DetailErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Hủy" Command="{Binding CloseMaterialEditorCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Lưu" Command="{Binding SaveMaterialCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" MinWidth="110" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================== Grade column editor ===================== -->
        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding IsGradeColumnEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalPanelStyle}">
                <StackPanel>
                    <TextBlock Text="Cột điểm" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="Tên cột điểm *" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4" />
                    <TextBox Text="{Binding GradeColumnName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" MaxLength="200"
                             ToolTip="Ví dụ: PT1, Assignment, Lab, Practical Exam, Final exam" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Trọng số (%) *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding GradeColumnWeightPercent, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CatalogTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Điểm tối thiểu (nếu có)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding GradeColumnMinScore, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CatalogTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,10,0,0"
                               Text="Tổng trọng số của tất cả cột điểm trong một môn phải bằng 100%. Điểm tối thiểu là ngưỡng riêng của cột điểm - dưới ngưỡng này là trượt môn dù điểm tổng kết vẫn đạt 5.0." />

                    <Border Style="{StaticResource ErrorBannerStyle}" Margin="0,12,0,0"
                            Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DetailErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Hủy" Command="{Binding CloseGradeColumnEditorCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Lưu" Command="{Binding SaveGradeColumnCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" MinWidth="110" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================== Schedule editor ===================== -->
        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding IsScheduleEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalPanelStyle}">
                <StackPanel>
                    <TextBlock Text="Lịch kiểm tra dự kiến" Style="{StaticResource SectionTitleStyle}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Buổi *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ScheduleSessionNo, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CatalogTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hình thức" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ScheduleTeachingType, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CatalogTextBoxStyle}" MaxLength="100" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Nội dung kiểm tra *" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding ScheduleTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" MaxLength="500" />

                    <TextBlock Text="Mô tả" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding ScheduleDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogMultilineTextBoxStyle}" />

                    <TextBlock Text="Ngày dự kiến" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                    <DatePicker SelectedDate="{Binding ScheduleExpectedDate}" MinHeight="40" />

                    <Border Style="{StaticResource ErrorBannerStyle}" Margin="0,12,0,0"
                            Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DetailErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Hủy" Command="{Binding CloseScheduleEditorCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Lưu" Command="{Binding SaveScheduleItemCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" MinWidth="110" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
