<UserControl x:Class="App.Views.Catalog.CurriculumAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1280">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}" Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Quản Lý Chương Trình Học" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"
                           Text="Gán môn học vào ngành theo từng kỳ, sắp xếp thứ tự, gán/xóa hàng loạt và xuất chương trình học ra CSV." />
            </StackPanel>
            <Button Content="Xuất CSV" Command="{Binding ExportCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    IsEnabled="{Binding HasMajorSelected}" />
        </Grid>

        <!-- Major + filters -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ngành đào tạo" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding Majors}" SelectedItem="{Binding SelectedMajor}"
                              DisplayMemberPath="MajorCode" Style="{StaticResource CatalogComboBoxStyle}">
                        <ComboBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ChangeMajorCommand}" />
                        </ComboBox.InputBindings>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Kỳ" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding TermOptions}" SelectedItem="{Binding SelectedTermFilter}"
                              DisplayMemberPath="Display" Style="{StaticResource CatalogComboBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="Tìm môn trong chương trình" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <Button Grid.Column="3" Content="Tải lại" Command="{Binding ChangeMajorCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="10,18,0,0" VerticalAlignment="Top" />
                <Button Grid.Column="4" Content="Lọc" Command="{Binding ApplyFiltersCommand}"
                        Style="{StaticResource GhostButtonStyle}" Margin="8,18,0,0" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <!-- Banners -->
        <StackPanel Grid.Row="2">
            <Border Style="{StaticResource StatusBannerStyle}"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}"
                           FontWeight="Bold" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource ErrorBannerStyle}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           FontWeight="Bold" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Two panels: unassigned on the left, the curriculum on the right -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Assign panel -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Môn chưa có trong chương trình"
                               Style="{StaticResource SectionTitleStyle}" />

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding AssignSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CatalogTextBoxStyle}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchUnassignedCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Tìm" Command="{Binding SearchUnassignedCommand}"
                                Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
                    </Grid>

                    <ListBox Grid.Row="2" ItemsSource="{Binding UnassignedCourses}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="4"
                                          Style="{StaticResource CatalogCheckBoxStyle}">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Course.CourseCode, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text=" - " />
                                        <Run Text="{Binding Course.CourseName, Mode=OneWay}" />
                                        <Run Text=" (" /><Run Text="{Binding Course.Credits, Mode=OneWay}" /><Run Text=" TC)" />
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Chọn tất cả" Command="{Binding SelectAllUnassignedCommand}"
                                    Style="{StaticResource GhostButtonStyle}" />
                            <Button Content="Bỏ chọn" Command="{Binding ClearUnassignedSelectionCommand}"
                                    Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Gán vào kỳ" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding AssignTargetTermNo, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CatalogTextBoxStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Gán môn đã chọn ▶"
                                    Command="{Binding AssignSelectedCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="10,18,0,0" VerticalAlignment="Top" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Curriculum panel -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Chương trình học của ngành" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0" />
                        <!-- Displayed prominently: this must equal Major.RequiredCredits,
                             which is the denominator of every graduation percentage. -->
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Run Text="Tổng tín chỉ toàn chương trình:" />
                            <Run Text="{Binding CurriculumTotalCredits, Mode=OneWay}" FontWeight="ExtraBold" />
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                  Style="{StaticResource CatalogDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                                  CellStyle="{StaticResource CatalogCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kỳ" Binding="{Binding TermNo}" Width="60" />
                                <DataGridTextColumn Header="TT" Binding="{Binding DisplayOrder}" Width="55" />
                                <DataGridTextColumn Header="Mã môn" Binding="{Binding CourseCode}" Width="110" />
                                <DataGridTextColumn Header="Tên môn học" Binding="{Binding CourseName}" Width="*" />
                                <DataGridTextColumn Header="TC" Binding="{Binding Credits}" Width="55" />
                                <DataGridTemplateColumn Header="Thao tác" Width="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="▲"
                                                        Command="{Binding DataContext.MoveUpCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallActionButtonStyle}"
                                                        Background="{StaticResource SecondaryBrush}" MinWidth="38"
                                                        ToolTip="Đưa lên trước trong kỳ" />
                                                <Button Content="▼"
                                                        Command="{Binding DataContext.MoveDownCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallActionButtonStyle}"
                                                        Background="{StaticResource SecondaryBrush}" MinWidth="38"
                                                        Margin="6,0,0,0" ToolTip="Đưa xuống sau trong kỳ" />
                                                <Button Content="Xóa"
                                                        Command="{Binding DataContext.RemoveItemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallActionButtonStyle}"
                                                        Background="{StaticResource DangerBrush}" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="{StaticResource CardBrush}"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🗂️" FontSize="42" HorizontalAlignment="Center" />
                                <TextBlock Text="Chương trình học chưa có môn nào"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Margin="0,10,0,4" HorizontalAlignment="Center" />
                                <TextBlock Text="Chọn môn ở danh sách bên trái rồi bấm 'Gán môn đã chọn'."
                                           Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="#CCFFFFFF"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="6"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                         Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center"
                                   Margin="0,0,14,0">
                            <Run Text="Hiển thị" /><Run Text=" " /><Run Text="{Binding TotalCount, Mode=OneWay}" />
                            <Run Text="môn · Trang" /><Run Text=" " /><Run Text="{Binding PageNumber, Mode=OneWay}" />
                            <Run Text="/" /><Run Text="{Binding PageCount, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="◀ Trước" Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Sau ▶" Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}" Style="{StaticResource GhostButtonStyle}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
