<UserControl x:Class="App.Views.Auth.AcademicProfileSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1050"
             Background="#FFFFFF">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEC868"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#F5B94C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" TargetName="border" Value="#E5DDCB"/>
                                <Setter Property="Foreground" Value="#A39688"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#FAF8F5"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="18,0,18,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#FEC868"/>
                                <Setter Property="Background" TargetName="border" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Branding Area -->
        <Border Grid.Column="0" Background="#473C33" CornerRadius="0">
            <Grid Margin="40">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="64" Height="64" Background="#FEC868" CornerRadius="18" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <TextBlock Text="🎓" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="FPT Academic Tracker" Foreground="#FEC868" FontSize="26" FontWeight="ExtraBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Thiết lập Hồ sơ Học tập" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                    <TextBlock Text="Chào mừng bạn đến với hệ thống FAT! Vui lòng chọn Ngành học và Kỳ học hiện tại để khởi tạo chương trình đào tạo của bạn." 
                               Foreground="#C4B8AA" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>

                <TextBlock Text="FAT System v1.0 • Modern Academic Management" Foreground="#8C7E72" FontSize="12" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- Right Setup Form Area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Padding="50,40">
                <StackPanel MaxWidth="460" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Hoàn Tất Hồ Sơ Học Tập" FontSize="28" FontWeight="ExtraBold" Foreground="#473C33" Margin="0,0,0,6"/>
                    <TextBlock Text="Vui lòng thiết lập thông tin ban đầu (chỉ xuất hiện trong lần đăng nhập đầu tiên)." 
                               FontSize="14" Foreground="#8C7E72" Margin="0,0,0,28" TextWrapping="Wrap"/>

                    <!-- Error Banner -->
                    <Border Background="#FEE2E2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,20"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Student Code (Read Only) -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="MÃ SỐ SINH VIÊN (MSSV)" FontSize="12" FontWeight="ExtraBold" Foreground="#473C33" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding StudentCode, Mode=OneWay}" Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True" Background="#F5F2EC"/>
                    </StackPanel>

                    <!-- Full Name -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="HỌ VÀ TÊN (*)" FontSize="12" FontWeight="ExtraBold" Foreground="#473C33" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="EMAIL (*)" FontSize="12" FontWeight="ExtraBold" Foreground="#473C33" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Phone Number -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="SỐ ĐIỆN THOẠI (*)" FontSize="12" FontWeight="ExtraBold" Foreground="#473C33" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Major Selection -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="NGÀNH ĐÀO TẠO (*)" FontSize="12" FontWeight="ExtraBold" Foreground="#473C33" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Majors}" SelectedItem="{Binding SelectedMajor}" DisplayMemberPath="MajorName" 
                                  Height="44" Style="{StaticResource CatalogComboBoxStyle}"/>
                    </StackPanel>

                    <!-- Class Name Dropdown -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="LỚP HỌC (*)" FontSize="12" FontWeight="ExtraBold" Foreground="#473C33" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ClassOptions}" SelectedItem="{Binding SelectedClassName}" 
                                  Height="44" Style="{StaticResource CatalogComboBoxStyle}"/>
                    </StackPanel>

                    <!-- Submit Button -->
                    <Button Content="💾 Lưu Hồ Sơ &amp; Vào Ứng Dụng ➔" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
