<UserControl x:Class="App.Views.Auth.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:App.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" xmlns:converters="clr-namespace:App.Converters"/>

        <!-- Modern PasswordBox Style -->
        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="18,0,18,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="18,0,18,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#ABC270"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#9AB160"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResetPasswordButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FDA769"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#F59450"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic Toggle Status Button Style (Red when Active -> Lock, Green when Locked -> Unlock) -->
        <Style x:Key="ToggleUserStatusButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Content" Value="🔒 Khóa Tài Khoản"/>
                    <Setter Property="Background" Value="#D9534F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Content" Value="🔓 Mở Khóa"/>
                    <Setter Property="Background" Value="#ABC270"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Column Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="#7C6E65"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Cell Style for Vertical Line Separators & Padding -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FAF6EE"/>
                    <Setter Property="Foreground" Value="#473C33"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- MAIN CONTENT AREA -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <Border Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="24" Padding="32">
                    <Border.Effect>
                        <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.06"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Header Bar with Title and Back to Home Button -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🛡️ QUẢN LÝ TÀI KHOẢN NGƯỜI DÙNG" FontSize="22" FontWeight="ExtraBold" Foreground="#473C33" VerticalAlignment="Center"/>

                            <Button Grid.Column="1" 
                                    Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type views:DashboardView}}}"
                                    CommandParameter="Home"
                                    Content="⬅ Quay Lại Trang Chủ" 
                                    Style="{StaticResource ActionButtonStyle}" 
                                    Background="#FAF6EE" Foreground="#473C33" BorderBrush="#E5DDCB" BorderThickness="1.5"
                                    Padding="16,8" FontSize="13"/>
                        </Grid>

                        <!-- Loading Progress Bar -->
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,16" Foreground="#ABC270"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>

                        <!-- Search Bar & Filters -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,12,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding LoadUsersCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Command="{Binding LoadUsersCommand}" Content="🔍 Tìm Kiếm" Style="{StaticResource ActionButtonStyle}" Padding="24,10" MinWidth="140"/>
                        </Grid>

                        <!-- Status Message -->
                        <Border Background="#F4F8EB" BorderBrush="#ABC270" BorderThickness="1.5" CornerRadius="12" Padding="14" Margin="0,0,0,16"
                                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#4B601C" FontSize="13" FontWeight="Bold"/>
                        </Border>

                        <!-- Error Message -->
                        <Border Background="#FFF0F0" BorderBrush="#E74C3C" BorderThickness="1.5" CornerRadius="12" Padding="14" Margin="0,0,0,16"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" FontSize="13" FontWeight="Bold"/>
                        </Border>

                        <!-- User DataGrid -->
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="True"
                                  Background="Transparent" BorderThickness="1" BorderBrush="#E5DDCB" RowHeaderWidth="0" 
                                  GridLinesVisibility="All"
                                  HeadersVisibility="Column" FontSize="13" Foreground="#473C33"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="UserID" Binding="{Binding UserId}" Width="65"/>
                                <DataGridTextColumn Header="Tên Đăng Nhập" Binding="{Binding Username}" Width="130"/>
                                <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="*" MinWidth="160"/>
                                <DataGridTextColumn Header="Mã Sinh Viên" Binding="{Binding StudentCode}" Width="110"/>
                                <DataGridTextColumn Header="Ngành Học" Binding="{Binding MajorName}" Width="150"/>
                                <DataGridTextColumn Header="Quyền (Role)" Binding="{Binding RoleName}" Width="100"/>
                                <DataGridTemplateColumn Header="Trạng Thái" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsActive, Mode=OneWay}" 
                                                      IsEnabled="False"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ngày Tạo" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="95"/>
                                <DataGridTemplateColumn Header="Thao Tác" Width="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ToggleUserStatusCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource ToggleUserStatusButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Reset Mật Khẩu" Width="155">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenResetPasswordModalCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}" Content="🔑 Reset Mật Khẩu" Style="{StaticResource ResetPasswordButtonStyle}" Padding="12,6" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- RESET PASSWORD OVERLAY MODAL FORM -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsResetModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="480" Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="24" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="12" BlurRadius="32" Opacity="0.18"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header with Title and Close Button -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🔑 ĐẶT LẠI MẬT KHẨU" FontSize="20" FontWeight="ExtraBold" Foreground="#473C33"/>
                            <TextBlock Text="Cập nhật mật khẩu mới cho tài khoản người dùng" FontSize="12" Foreground="#7C6E65" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding CloseResetPasswordModalCommand}" Content="✕" 
                                Background="Transparent" Foreground="#7C6E65" FontSize="18" FontWeight="Bold" 
                                BorderThickness="0" Cursor="Hand" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- User Summary Badge -->
                    <Border Background="#FAF6EE" BorderBrush="#E5DDCB" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Tên đăng nhập: " FontSize="13" Foreground="#7C6E65"/>
                                <TextBlock Text="{Binding ResetTargetUser.Username}" FontSize="13" FontWeight="ExtraBold" Foreground="#473C33"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Họ và tên: " FontSize="13" Foreground="#7C6E65"/>
                                <TextBlock Text="{Binding ResetTargetUser.FullName}" FontSize="13" FontWeight="Bold" Foreground="#473C33"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mã Sinh Viên / Ngành: " FontSize="12" Foreground="#7C6E65"/>
                                <TextBlock Text="{Binding ResetTargetUser.StudentCode, TargetNullValue='N/A'}" FontSize="12" FontWeight="Bold" Foreground="#473C33"/>
                                <TextBlock Text=" - " FontSize="12" Foreground="#7C6E65"/>
                                <TextBlock Text="{Binding ResetTargetUser.MajorName, TargetNullValue='N/A'}" FontSize="12" FontWeight="Bold" Foreground="#473C33"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Error Alert Banner -->
                    <Border Background="#FFF3EB" BorderBrush="#FDA769" BorderThickness="1.5" CornerRadius="12" Padding="12" Margin="0,0,0,16"
                            Visibility="{Binding HasModalError, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ModalErrorMessage}" Foreground="#C85210" FontSize="13" FontWeight="ExtraBold" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Field 1: Mật khẩu mới -->
                    <TextBlock Text="Mật khẩu mới *" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <PasswordBox x:Name="TxtModalNew" PasswordChanged="TxtModalNew_PasswordChanged" Style="{StaticResource ModernPasswordBoxStyle}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisConverter}}"/>
                        <TextBox x:Name="TxtModalNewPlain" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" TextChanged="TxtModalNewPlain_TextChanged" Style="{StaticResource ModernTextBoxStyle}"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>

                    <!-- Field 2: Xác nhận mật khẩu mới -->
                    <TextBlock Text="Xác nhận mật khẩu mới *" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <PasswordBox x:Name="TxtModalConfirm" PasswordChanged="TxtModalConfirm_PasswordChanged" Style="{StaticResource ModernPasswordBoxStyle}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisConverter}}"/>
                        <TextBox x:Name="TxtModalConfirmPlain" Text="{Binding ConfirmNewPassword, UpdateSourceTrigger=PropertyChanged}" TextChanged="TxtModalConfirmPlain_TextChanged" Style="{StaticResource ModernTextBoxStyle}"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>

                    <!-- Show Password Checkbox -->
                    <CheckBox Content="Hiển thị mật khẩu" IsChecked="{Binding IsPasswordVisible}" Foreground="#473C33" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding CloseResetPasswordModalCommand}" Content="❌ Hủy Bỏ" 
                                Style="{StaticResource ActionButtonStyle}" Background="#FAF6EE" Foreground="#473C33" BorderBrush="#E5DDCB" BorderThickness="1.5"/>

                        <Button Grid.Column="2" Command="{Binding ConfirmResetPasswordCommand}" Content="💾 Lưu Mật Khẩu" 
                                Style="{StaticResource ActionButtonStyle}" Background="#FDA769" Foreground="#FFFFFF"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
