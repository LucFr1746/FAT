<UserControl x:Class="App.Views.Auth.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280"
             Background="#FAF6EE">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>

        <!-- Primary Button Style (#FEC868) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEC868"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#FDB833"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" TargetName="border" Value="#E5DDCB"/>
                                <Setter Property="Foreground" Value="#A39688"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="18,0,18,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#ABC270"/>
                                <Setter Property="Background" TargetName="border" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
        <Border Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="24" Padding="36,40">
            <Border.Effect>
                <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="6" BlurRadius="24" Opacity="0.08"/>
            </Border.Effect>

            <StackPanel>
                <!-- Brand Header -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#FAF6EE" Margin="0,0,12,0">
                        <TextBlock Text="🔑" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FAT SYSTEM" FontSize="18" FontWeight="ExtraBold" Foreground="#473C33"/>
                        <TextBlock Text="Đặt Lại Mật Khẩu" FontSize="13" FontWeight="Bold" Foreground="#ABC270"/>
                    </StackPanel>
                </StackPanel>

                <!-- Wizard Progress Indicator (Steps 1 - 2 - 3) -->
                <Grid Margin="0,8,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step 1 Badge -->
                    <Border Grid.Column="0" CornerRadius="10" Padding="8,6" Margin="0,0,4,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FAF6EE"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                        <Setter Property="Background" Value="#FEC868"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="1. Nhập MSSV" FontSize="11" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="#473C33"/>
                    </Border>

                    <!-- Step 2 Badge -->
                    <Border Grid.Column="1" CornerRadius="10" Padding="8,6" Margin="2,0,2,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FAF6EE"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                        <Setter Property="Background" Value="#FEC868"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="2. Mã OTP" FontSize="11" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="#473C33"/>
                    </Border>

                    <!-- Step 3 Badge -->
                    <Border Grid.Column="2" CornerRadius="10" Padding="8,6" Margin="4,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FAF6EE"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                        <Setter Property="Background" Value="#FEC868"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="3. Mật Khẩu Mới" FontSize="11" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="#473C33"/>
                    </Border>
                </Grid>

                <!-- Error Message Banner -->
                <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                </Border>

                <!-- Dev Demo OTP Banner Notice -->
                <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding HasDevOtpNotice, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding DevOtpNotice}" Foreground="#92400E" FontSize="13" FontWeight="ExtraBold" TextWrapping="Wrap"/>
                </Border>

                <!-- ================= STEP 1: ENTER MSSV / EMAIL ================= -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Nhập MSSV hoặc Email của bạn để nhận mã xác thực OTP:" FontSize="13" Foreground="#7C6E65" Margin="0,0,0,18" TextWrapping="Wrap"/>
                    
                    <TextBlock Text="MSSV hoặc Email (*)" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding MssvOrEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,24"/>

                    <Button Command="{Binding SendOtpCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GỬI MÃ XÁC THỰC OTP" VerticalAlignment="Center"/>
                            <TextBlock Text=" ➔" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ================= STEP 2: ENTER OTP CODE ================= -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Hệ thống đã gửi mã xác thực OTP 6 chữ số đến địa chỉ email:" FontSize="13" Foreground="#7C6E65" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding MaskedEmail}" FontSize="14" FontWeight="ExtraBold" Foreground="#473C33" Margin="0,0,0,18"/>

                    <TextBlock Text="Mã xác nhận OTP (6 chữ số) (*)" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <TextBox Text="{Binding OtpCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" MaxLength="6" FontSize="18" FontWeight="ExtraBold" TextAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Button Command="{Binding ResendOtpCommand}" Content="{Binding ResendButtonText}" IsEnabled="{Binding CanResend}"
                                Background="Transparent" Foreground="#473C33" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <Button Command="{Binding VerifyOtpCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="XÁC THỰC MÃ OTP" VerticalAlignment="Center"/>
                            <TextBlock Text=" ➔" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ================= STEP 3: NEW PASSWORD ================= -->
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Xác thực OTP thành công. Vui lòng nhập mật khẩu mới:" FontSize="13" Foreground="#7C6E65" Margin="0,0,0,18" TextWrapping="Wrap"/>

                    <TextBlock Text="Mật khẩu mới (*)" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,14"/>

                    <TextBlock Text="Xác nhận mật khẩu mới (*)" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,24"/>

                    <Button Command="{Binding ResetPasswordCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 HOÀN TẤT &amp; ĐĂNG NHẬP" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Navigation Back to Login -->
                <Button Command="{Binding NavigateToLoginCommand}" Content="❮ Quay lại Đăng Nhập" 
                        Background="Transparent" Foreground="#7C6E65" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" BorderThickness="0" Cursor="Hand" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
