<UserControl x:Class="App.Views.GradeGpa.GradeEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource GhostButtonStyle}" />
                <StackPanel>
                    <TextBlock Text="Manage Grades" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Record scores only for assessments already defined in the curriculum"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Student *" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Students}"
                                  SelectedItem="{Binding SelectedStudent}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource CatalogComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Course enrollment *"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Enrollments}"
                                  SelectedItem="{Binding SelectedEnrollment}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource CatalogComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" MinWidth="130">
                        <TextBlock Text="Final result" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding SelectedEnrollment.FinalScoreDisplay, TargetNullValue='Not selected'}"
                                   FontSize="18"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource ErrorBannerStyle}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />
            </Border>

            <ProgressBar Grid.Row="3"
                         IsIndeterminate="True"
                         Height="4"
                         Margin="0,0,0,10"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,14,0">
                    <DataGrid ItemsSource="{Binding Assessments}"
                              SelectedItem="{Binding SelectedAssessment}"
                              Style="{StaticResource CatalogDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                              CellStyle="{StaticResource CatalogCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Assessment"
                                                Binding="{Binding Name}"
                                                Width="*" />
                            <DataGridTextColumn Header="Weight (%)"
                                                Binding="{Binding WeightPercent, StringFormat=N2}"
                                                Width="110" />
                            <DataGridTextColumn Header="Minimum"
                                                Binding="{Binding MinScoreToPass, StringFormat=N1, TargetNullValue=—}"
                                                Width="100" />
                            <DataGridTextColumn Header="Score"
                                                Binding="{Binding Score, StringFormat=N2, TargetNullValue=—}"
                                                Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Select a student and course to load its assessments."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource PageSubtitleStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Assessments.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding EditModeLabel}"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding SelectedAssessment.Name, TargetNullValue='No assessment selected'}"
                                   FontSize="18"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" />

                        <WrapPanel Margin="0,8,0,12">
                            <Border Style="{StaticResource ChipBorderStyle}">
                                <TextBlock Style="{StaticResource ChipTextStyle}">
                                    <Run Text="Weight: " />
                                    <Run Text="{Binding SelectedAssessment.WeightPercent, Mode=OneWay, StringFormat=N2}" />
                                    <Run Text="%" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource ChipBorderStyle}">
                                <TextBlock Style="{StaticResource ChipTextStyle}">
                                    <Run Text="Maximum: " />
                                    <Run Text="10" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="Score *" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ScoreText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CatalogTextBoxStyle}" />

                        <Border Style="{StaticResource ErrorBannerStyle}"
                                Margin="0,12,0,0"
                                Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ValidationMessage}"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Style="{StaticResource StatusBannerStyle}"
                                Margin="0,12,0,0"
                                Visibility="{Binding HasSuccessMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SuccessMessage}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap" />
                        </Border>

                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="Save"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,8,8" />
                            <Button Content="Cancel edit"
                                    Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Margin="0,0,8,8" />
                            <Button Content="Delete grade"
                                    Command="{Binding RequestDeleteCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding IsDeleteConfirmationVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalPanelStyle}">
                <StackPanel>
                    <TextBlock Text="Delete recorded grade?"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="The component score will be removed and the course result will be recalculated. This does not delete the assessment."
                               Style="{StaticResource PageSubtitleStyle}" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">
                        <Button Content="Keep grade"
                                Command="{Binding CancelDeleteCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Delete"
                                Command="{Binding ConfirmDeleteCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
