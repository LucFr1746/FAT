<UserControl x:Class="App.Views.GradeGpa.GradeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <Button DockPanel.Dock="Right"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource GhostButtonStyle}" />
            <StackPanel>
                <TextBlock Text="View Grades" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Assessment scores and calculated course results"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Search by course code or name"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogSearchBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Semester" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding Semesters}"
                              SelectedItem="{Binding SelectedSemester}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource CatalogComboBoxStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource ErrorBannerStyle}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       FontWeight="Bold"
                       TextWrapping="Wrap" />
        </Border>

        <ProgressBar Grid.Row="3"
                     IsIndeterminate="True"
                     Height="4"
                     Margin="0,0,0,10"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <Grid Grid.Row="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Courses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="18"
                                                       FontWeight="ExtraBold"
                                                       Foreground="{StaticResource TextBrush}">
                                                <Run Text="{Binding CourseCode, Mode=OneWay}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding CourseName, Mode=OneWay}" />
                                            </TextBlock>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Border Style="{StaticResource ChipBorderStyle}">
                                                    <TextBlock Style="{StaticResource ChipTextStyle}">
                                                        <Run Text="{Binding SemesterCode, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding SemesterName, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                                <Border Style="{StaticResource ChipBorderStyle}">
                                                    <TextBlock Style="{StaticResource ChipTextStyle}">
                                                        <Run Text="{Binding Credits, Mode=OneWay}" />
                                                        <Run Text=" credits" />
                                                    </TextBlock>
                                                </Border>
                                                <Border Style="{StaticResource ChipBorderStyle}">
                                                    <TextBlock Style="{StaticResource ChipTextStyle}">
                                                        <Run Text="Attempt " />
                                                        <Run Text="{Binding AttemptNo, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       HorizontalAlignment="Right"
                                                       FontWeight="ExtraBold"
                                                       Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock HorizontalAlignment="Right" Margin="0,5,0,0">
                                                <Run Text="Final: " />
                                                <Run Text="{Binding FinalScore, Mode=OneWay, StringFormat=N1, TargetNullValue=—}"
                                                     FontWeight="ExtraBold" />
                                                <Run Text="  ·  Grade: " />
                                                <Run Text="{Binding LetterGrade, Mode=OneWay, TargetNullValue=—}"
                                                     FontWeight="ExtraBold" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding Assessments}"
                                              Style="{StaticResource CatalogDataGridStyle}"
                                              ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                                              CellStyle="{StaticResource CatalogCellStyle}"
                                              Margin="0,12,0,0"
                                              MaxHeight="240">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Assessment"
                                                                Binding="{Binding Name}"
                                                                Width="*" />
                                            <DataGridTextColumn Header="Weight (%)"
                                                                Binding="{Binding WeightPercent, StringFormat=N2}"
                                                                Width="120" />
                                            <DataGridTextColumn Header="Minimum"
                                                                Binding="{Binding MinScoreToPass, StringFormat=N1, TargetNullValue=—}"
                                                                Width="110" />
                                            <DataGridTextColumn Header="Score"
                                                                Binding="{Binding Score, StringFormat=N2, TargetNullValue=—}"
                                                                Width="110" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="{StaticResource SurfaceBrush}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No grade data found"
                               Style="{StaticResource SectionTitleStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Try another semester, clear the search, or refresh the data."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
