<UserControl x:Class="App.Views.GradeGpa.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{StaticResource SurfaceBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <Button DockPanel.Dock="Right"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource GhostButtonStyle}" />
            <StackPanel>
                <TextBlock Text="Statistics" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Academic performance calculated from current enrollment data"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Style="{StaticResource ErrorBannerStyle}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       FontWeight="Bold"
                       TextWrapping="Wrap" />
        </Border>

        <ProgressBar Grid.Row="2"
                     IsIndeterminate="True"
                     Height="4"
                     Margin="0,0,0,10"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Cumulative GPA" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding Statistics.CumulativeGpa, StringFormat=N2, TargetNullValue=—}"
                                           FontSize="25"
                                           FontWeight="ExtraBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Total courses" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding Statistics.TotalCourses}"
                                           FontSize="25"
                                           FontWeight="ExtraBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Passed / Failed" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock FontSize="25" FontWeight="ExtraBold">
                                    <Run Text="{Binding Statistics.PassedCourses, Mode=OneWay}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding Statistics.FailedCourses, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Studying" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding Statistics.StudyingCourses}"
                                           FontSize="25"
                                           FontWeight="ExtraBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Registered credits" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding Statistics.TotalCredits}"
                                           FontSize="25"
                                           FontWeight="ExtraBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Completed credits" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding Statistics.CompletedCredits}"
                                           FontSize="25"
                                           FontWeight="ExtraBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Incomplete credits" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding Statistics.IncompleteCredits}"
                                           FontSize="25"
                                           FontWeight="ExtraBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Average final score" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding Statistics.AverageFinalScore, StringFormat=N1, TargetNullValue=—}"
                                           FontSize="25"
                                           FontWeight="ExtraBold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,4,0,14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding Statistics.ProgramProgressPercent, StringFormat={}{0:N1}%}"
                                           DockPanel.Dock="Right"
                                           FontWeight="ExtraBold" />
                                <TextBlock Text="Curriculum progress"
                                           Style="{StaticResource SectionTitleStyle}" />
                            </DockPanel>
                            <ProgressBar Value="{Binding Statistics.ProgramProgressPercent}"
                                         Maximum="100"
                                         Height="14" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0">
                                <Run Text="{Binding Statistics.CompletedCredits, Mode=OneWay}" />
                                <Run Text=" of " />
                                <Run Text="{Binding Statistics.RequiredCredits, Mode=OneWay}" />
                                <Run Text=" required credits completed" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="GPA by semester"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <lvc:CartesianChart Series="{Binding GpaSeries}"
                                                    XAxes="{Binding GpaXAxes}"
                                                    Height="260" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Result status distribution"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <lvc:CartesianChart Series="{Binding StatusSeries}"
                                                    XAxes="{Binding StatusXAxes}"
                                                    Height="260" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="Highest score"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding Statistics.HighestCourse.CourseCode, TargetNullValue=—}"
                                           FontSize="18"
                                           FontWeight="ExtraBold" />
                                <TextBlock Text="{Binding Statistics.HighestCourse.CourseName}"
                                           Style="{StaticResource PageSubtitleStyle}" />
                                <TextBlock Text="{Binding Statistics.HighestCourse.FinalScore, StringFormat='Score: {0:N1}', TargetNullValue='Score: —'}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Lowest score"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding Statistics.LowestCourse.CourseCode, TargetNullValue=—}"
                                           FontSize="18"
                                           FontWeight="ExtraBold" />
                                <TextBlock Text="{Binding Statistics.LowestCourse.CourseName}"
                                           Style="{StaticResource PageSubtitleStyle}" />
                                <TextBlock Text="{Binding Statistics.LowestCourse.FinalScore, StringFormat='Score: {0:N1}', TargetNullValue='Score: —'}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding Statistics.GpaBySemester}"
                                  Style="{StaticResource CatalogDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                                  CellStyle="{StaticResource CatalogCellStyle}"
                                  Margin="0,0,7,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Semester"
                                                    Binding="{Binding SemesterCode}"
                                                    Width="*" />
                                <DataGridTextColumn Header="GPA"
                                                    Binding="{Binding Gpa, StringFormat=N2, TargetNullValue=—}"
                                                    Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid Grid.Column="1"
                                  ItemsSource="{Binding Statistics.StatusDistribution}"
                                  Style="{StaticResource CatalogDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                                  CellStyle="{StaticResource CatalogCellStyle}"
                                  Margin="7,0,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding Status}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Courses"
                                                    Binding="{Binding Count}"
                                                    Width="90" />
                                <DataGridTextColumn Header="Percent"
                                                    Binding="{Binding Percent, StringFormat={}{0:N1}%}"
                                                    Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Background="{StaticResource SurfaceBrush}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No academic statistics are available."
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Statistics appear after the student has enrollment data."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
