<UserControl x:Class="App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="880" d:DesignWidth="1280"
             Background="#FFFFFF">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" xmlns:converters="clr-namespace:App.Converters"/>

        <!-- Header Tab Button Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#FEC868"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#FEC868"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Profile Badge Clickable Button Style -->
        <Style x:Key="UserProfileBadgeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#FAF6EE"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#ABC270"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Menu Item Button Style -->
        <Style x:Key="PopupMenuItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#FAF6EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Logout Menu Item Button Style -->
        <Style x:Key="PopupLogoutMenuItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C85210"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#FFF3EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR NAVIGATION (Sage Green Accent #ABC270) -->
        <Border Grid.Row="0" Background="#ABC270" Padding="24,14">
            <Border.Effect>
                <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.12"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- System Logo (Graduation Cap / Mortarboard Icon) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#FFFFFF" Margin="0,0,12,0">
                        <Path Data="M12 3L1 9L12 15L21 10.09V17H23V9M5 13.18V17.18C5 17.18 8 20 12 20C16 20 19 17.18 19 17.18V13.18L12 17.09L5 13.18Z" 
                              Fill="#473C33" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FAT SYSTEM" FontSize="22" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="FPT Academic &amp; Conduct Tracker" FontSize="11" FontWeight="Bold" Foreground="#473C33"/>
                    </StackPanel>
                </StackPanel>

                <!--
                    Navigation tabs. Catalog-admin screens are grouped behind a
                    single "Quản Lý Đào Tạo" dropdown instead of sitting inline:
                    six-plus standalone buttons plus one more every time a module
                    ships is what forces a horizontal scrollbar onto the bar.
                    Every tab is gated on role; DashboardViewModel.SwitchTabAsync
                    re-checks the same condition, since a hidden button is not
                    authorization.
                -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="Home" Content="🏠 Trang Chủ" Style="{StaticResource NavTabButtonStyle}"/>

                    <!-- Student -->
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="MyCurriculum" Content="📖 Chương Trình Học"
                            Style="{StaticResource NavTabButtonStyle}"
                            Visibility="{Binding IsStudent, Converter={StaticResource BoolToVisConverter}}"/>
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="GpaPrediction" Content="📈 Dự Đoán GPA"
                            Style="{StaticResource NavTabButtonStyle}"
                            Visibility="{Binding IsStudent, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- Admin: catalog administration, grouped behind one dropdown -->
                    <Button x:Name="CatalogMenuBtn" Command="{Binding ToggleCatalogMenuCommand}" Content="🗂️ Quản Lý Đào Tạo ▾"
                            Style="{StaticResource NavTabButtonStyle}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"/>
                    <Popup IsOpen="{Binding IsCatalogMenuOpen, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=CatalogMenuBtn}" Placement="Bottom" PopupAnimation="Slide" AllowsTransparency="True">
                        <Border Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="16" Width="240" Margin="0,8,0,0" Padding="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.12"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Group 1: khung đào tạo -->
                                <Button Command="{Binding SwitchTabCommand}" CommandParameter="SemesterAdmin" Style="{StaticResource PopupMenuItemButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🗓️" Margin="0,0,10,0"/>
                                        <TextBlock Text="Kỳ Học"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SwitchTabCommand}" CommandParameter="MajorAdmin" Style="{StaticResource PopupMenuItemButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎓" Margin="0,0,10,0"/>
                                        <TextBlock Text="Ngành"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Height="1" Fill="#E5DDCB" Margin="4,6"/>

                                <!-- Group 2: nội dung chương trình -->
                                <Button Command="{Binding SwitchTabCommand}" CommandParameter="SubjectAdmin" Style="{StaticResource PopupMenuItemButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📚" Margin="0,0,10,0"/>
                                        <TextBlock Text="Môn Học"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SwitchTabCommand}" CommandParameter="CurriculumAdmin" Style="{StaticResource PopupMenuItemButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🗂️" Margin="0,0,10,0"/>
                                        <TextBlock Text="Chương Trình"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SwitchTabCommand}" CommandParameter="FlmImport" Style="{StaticResource PopupMenuItemButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬇️" Margin="0,0,10,0"/>
                                        <TextBlock Text="Import FLM"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Admin: account management stays top-level -->
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="UserManagement" Content="🛡️ Tài Khoản"
                            Style="{StaticResource NavTabButtonStyle}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"/>
                </StackPanel>

                <!-- User Profile Clickable Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UserProfileBtn" Command="{Binding ToggleProfileMenuCommand}" Style="{StaticResource UserProfileBadgeButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Profile Circle Avatar -->
                            <Border Width="34" Height="34" CornerRadius="17" Background="#FEC868" Margin="0,0,10,0">
                                <TextBlock Text="👤" Foreground="#473C33" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding CurrentUserContext.User.FullName}" FontWeight="ExtraBold" FontSize="13" Foreground="#473C33"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Role: " FontSize="11" Foreground="#7C6E65"/>
                                    <TextBlock Text="{Binding CurrentUserContext.User.RoleName}" FontSize="11" FontWeight="ExtraBold" Foreground="#473C33"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Dropdown Arrow Indicator -->
                            <TextBlock Text="▼" FontSize="10" Foreground="#7C6E65" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Popup Dropdown Menu attached to UserProfileBtn -->
                    <Popup IsOpen="{Binding IsProfileMenuOpen, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=UserProfileBtn}" Placement="Bottom" PopupAnimation="Slide" AllowsTransparency="True">
                        <Border Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="16" Width="260" Margin="0,8,0,0" Padding="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.12"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- User Summary Info Header -->
                                <Border Background="#FAF6EE" CornerRadius="12" Padding="14" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentUserContext.User.FullName}" FontWeight="ExtraBold" FontSize="14" Foreground="#473C33"/>
                                        <TextBlock Text="{Binding CurrentUserContext.User.Email}" FontSize="12" Foreground="#7C6E65" Margin="0,2,0,0"/>
                                        <Border Background="#ABC270" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding CurrentUserContext.User.RoleName}" FontSize="10" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Menu Item 1: Chỉnh sửa hồ sơ (Hiển thị CHỈ KHI là Student) -->
                                <Button Command="{Binding SwitchTabCommand}" CommandParameter="Profile" Style="{StaticResource PopupMenuItemButtonStyle}"
                                        Visibility="{Binding IsStudent, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤" Margin="0,0,10,0"/>
                                        <TextBlock Text="Chỉnh Sửa Hồ Sơ"/>
                                    </StackPanel>
                                </Button>

                                <!-- Menu Item 2: Quản lý tài khoản (Hiển thị CHỈ KHI là Admin) -->
                                <Button Command="{Binding SwitchTabCommand}" CommandParameter="UserManagement" Style="{StaticResource PopupMenuItemButtonStyle}"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡️" Margin="0,0,10,0"/>
                                        <TextBlock Text="Quản Lý Tài Khoản"/>
                                    </StackPanel>
                                </Button>

                                <!-- Menu Item 3: Thay đổi mật khẩu -->
                                <Button Command="{Binding SwitchTabCommand}" CommandParameter="ChangePassword" Style="{StaticResource PopupMenuItemButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔑" Margin="0,0,10,0"/>
                                        <TextBlock Text="Thay Đổi Mật Khẩu"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Height="1" Fill="#E5DDCB" Margin="4,6"/>

                                <!-- Menu Item 3: Đăng xuất -->
                                <Button Command="{Binding LogoutCommand}" Style="{StaticResource PopupLogoutMenuItemButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚪" Margin="0,0,10,0"/>
                                        <TextBlock Text="Đăng Xuất"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY CONTENT AREA -->
        <Grid Grid.Row="1">
            <!-- Dynamic Sub-Content (Profile, ChangePassword, UserManagement) -->
            <ContentControl Content="{Binding CurrentTabViewModel}"
                            Visibility="{Binding IsHomeTab, Converter={StaticResource InverseBoolToVisConverter}}"/>

            <!-- Default Home Dashboard Content (Shown when IsHomeTab is True) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsHomeTab, Converter={StaticResource BoolToVisConverter}}">

                <StackPanel Margin="28">
                    <!-- Hero Banner Card -->
                    <Border Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="24" Padding="36" Margin="0,0,0,28">
                        <Border.Effect>
                            <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.06"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border Background="#FAF6EE" BorderBrush="#ABC270" BorderThickness="1" CornerRadius="10" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <TextBlock Text="ĐẠI HỌC FPT • HỆ THỐNG RÈN LUYỆN SINH VIÊN" Foreground="#473C33" FontWeight="ExtraBold" FontSize="12"/>
                                </Border>
                                <TextBlock Text="Chào Mừng Bạn Quay Trở Lại Hệ Thống FAT!" FontSize="28" FontWeight="ExtraBold" Foreground="#473C33" Margin="0,0,0,10"/>
                                <TextBlock Text="Theo dõi điểm rèn luyện, đăng ký sự kiện ngoại khóa và cập nhật hồ sơ cá nhân nhanh chóng." FontSize="14" Foreground="#7C6E65" Margin="0,0,0,24" TextWrapping="Wrap"
                                           Visibility="{Binding IsStudent, Converter={StaticResource BoolToVisConverter}}"/>
                                <TextBlock Text="Hệ thống quản lý đào tạo học thuật. Cập nhật chương trình khung, điều phối kỳ học và quản lý danh mục môn học." FontSize="14" Foreground="#7C6E65" Margin="0,0,0,24" TextWrapping="Wrap"
                                           Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"/>

                                <StackPanel Orientation="Horizontal">
                                    <!-- Student Action Button -->
                                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="Profile" Style="{StaticResource NavTabButtonStyle}" Background="#FEC868" Foreground="#473C33" BorderThickness="0" Padding="22,12"
                                            Visibility="{Binding IsStudent, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Xem Hồ Sơ Cá Nhân ➔" FontWeight="ExtraBold" FontSize="14"/>
                                    </Button>

                                    <!-- Admin Action Button -->
                                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="UserManagement" Style="{StaticResource NavTabButtonStyle}" Background="#FEC868" Foreground="#473C33" BorderThickness="0" Padding="22,12"
                                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Truy Cập Quản Lý Tài Khoản ➔" FontWeight="ExtraBold" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Hero Graphic Element with Graduation Cap -->
                            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="160" Height="160" Fill="#ABC270" Opacity="0.2"/>
                                <Ellipse Width="120" Height="120" Fill="#FEC868" Opacity="0.3"/>
                                <Path Data="M12 3L1 9L12 15L21 10.09V17H23V9M5 13.18V17.18C5 17.18 8 20 12 20C16 20 19 17.18 19 17.18V13.18L12 17.09L5 13.18Z" 
                                      Fill="#473C33" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Feature Cards Section (Student) -->
                    <StackPanel Visibility="{Binding IsStudent, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="Tính Năng Nổi Bật" FontSize="18" FontWeight="ExtraBold" Foreground="#473C33" Margin="0,0,0,18"/>
                        <UniformGrid Columns="2">
                            <!-- Card 1: Profile -->
                            <Border Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="20" Padding="24" Margin="0,0,12,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.05"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="38" Height="38" CornerRadius="12" Background="#FAF6EE" Margin="0,0,10,0">
                                            <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Hồ Sơ Sinh Viên" FontSize="17" FontWeight="ExtraBold" Foreground="#473C33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Xem thông tin mã số sinh viên, ngành học và cập nhật địa chỉ liên hệ." FontSize="13" Foreground="#7C6E65" Margin="0,4,0,16" TextWrapping="Wrap"/>
                                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="Profile" Content="Chi Tiết ➔" Background="Transparent" Foreground="#473C33" FontWeight="ExtraBold" FontSize="13" HorizontalAlignment="Left" Padding="0" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Security -->
                            <Border Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="20" Padding="24" Margin="12,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.05"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="38" Height="38" CornerRadius="12" Background="#FAF6EE" Margin="0,0,10,0">
                                            <TextBlock Text="🔑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Đổi Mật Khẩu" FontSize="17" FontWeight="ExtraBold" Foreground="#473C33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Bảo mật tài khoản cá nhân, thay đổi mật khẩu định kỳ an toàn." FontSize="13" Foreground="#7C6E65" Margin="0,4,0,16" TextWrapping="Wrap"/>
                                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="ChangePassword" Content="Đổi Mật Khẩu ➔" Background="Transparent" Foreground="#473C33" FontWeight="ExtraBold" FontSize="13" HorizontalAlignment="Left" Padding="0" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Dashboard KPIs / Quick Actions (Admin) -->
                    <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="Thông Số Dashboard" FontSize="18" FontWeight="ExtraBold" Foreground="#473C33" Margin="0,0,0,18"/>
                        <UniformGrid Columns="3">
                            <!-- KPI 1: Current semester -->
                            <Border Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="20" Padding="24" Margin="0,0,12,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.05"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="38" Height="38" CornerRadius="12" Background="#FAF6EE" Margin="0,0,10,0">
                                            <TextBlock Text="🗓️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Kỳ Học Hiện Tại" FontSize="15" FontWeight="ExtraBold" Foreground="#473C33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentSemesterLabel}" FontSize="18" FontWeight="ExtraBold" Foreground="#473C33" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI 2: Subject count -->
                            <Border Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="20" Padding="24" Margin="6,0,6,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.05"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="38" Height="38" CornerRadius="12" Background="#FAF6EE" Margin="0,0,10,0">
                                            <TextBlock Text="📚" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Tổng Số Môn Học" FontSize="15" FontWeight="ExtraBold" Foreground="#473C33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalSubjectCount}" FontSize="28" FontWeight="ExtraBold" Foreground="#473C33"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI 3: Quick create -->
                            <Border Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="20" Padding="24" Margin="12,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.05"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="38" Height="38" CornerRadius="12" Background="#FAF6EE" Margin="0,0,10,0">
                                            <TextBlock Text="➕" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Tác Vụ Nhanh" FontSize="15" FontWeight="ExtraBold" Foreground="#473C33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="SubjectAdmin" Content="+ Thêm Môn Học Mới"
                                            Style="{StaticResource NavTabButtonStyle}" Background="#FEC868" Foreground="#473C33" BorderThickness="0"
                                            HorizontalAlignment="Left" Margin="0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
