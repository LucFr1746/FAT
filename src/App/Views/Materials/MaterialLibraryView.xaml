<UserControl x:Class="App.Views.Materials.MaterialLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- Outer grid holds the page plus the upload modal overlay. No outer
         ScrollViewer: the DataGrid (row 3) scrolls its own rows internally. -->
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Tài Liệu Học Tập" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"
                               Text="Tra cứu tài liệu theo môn học. Bấm &quot;Tải xuống&quot; để mở liên kết (tài liệu FLM) hoặc lưu tệp đã tải lên." />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="180"
                        Content="⬆ Tải lên tài liệu"
                        Command="{Binding OpenUploadPanelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- Filter bar -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource CatalogSearchBoxStyle}"
                             VerticalAlignment="Center"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Tìm theo môn học (mã/tên) hoặc tên tài liệu...">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <ComboBox Grid.Column="2" Width="180" VerticalAlignment="Center"
                              Style="{StaticResource CatalogComboBoxStyle}"
                              ItemsSource="{Binding Majors}"
                              SelectedItem="{Binding SelectedMajor}"
                              DisplayMemberPath="Display"
                              materialDesign:HintAssist.Hint="Tất cả ngành"
                              Visibility="{Binding ShowMajorFilter, Converter={StaticResource BoolToVis}}" />

                    <ComboBox Grid.Column="4" Width="140" VerticalAlignment="Center"
                              Style="{StaticResource CatalogComboBoxStyle}"
                              ItemsSource="{Binding Terms}"
                              SelectedItem="{Binding SelectedTerm}"
                              DisplayMemberPath="Display"
                              materialDesign:HintAssist.Hint="Tất cả kỳ" />

                    <CheckBox Grid.Column="6" VerticalAlignment="Center"
                              Style="{StaticResource CatalogCheckBoxStyle}"
                              Content="Chỉ tài liệu có link"
                              IsChecked="{Binding OnlyDownloadable}" />

                    <Button Grid.Column="8" Content="Tìm kiếm" MinWidth="120"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />

                    <Button Grid.Column="10" Content="Xóa lọc"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource GhostButtonStyle}" />
                </Grid>
            </Border>

            <!-- Banners -->
            <StackPanel Grid.Row="2">
                <Border Style="{StaticResource StatusBannerStyle}"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}"
                               FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- Results -->
            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,4,0,0">
                <Grid>
                    <!-- One card per subject: a header, then the subject's material rows.
                         Built with nested ItemsControls so the layout is fully explicit. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,14" CornerRadius="10"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Background="{StaticResource CardBrush}">
                                        <StackPanel>
                                            <!-- Subject header -->
                                            <Border Background="{StaticResource SuccessBackgroundBrush}"
                                                    CornerRadius="10,10,0,0" Padding="14,10">
                                                <TextBlock FontWeight="Bold" FontSize="14"
                                                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                                                    <Run Text="{Binding SubjectDisplay, Mode=OneWay}" />
                                                    <Run Text="{Binding Count, Mode=OneWay, StringFormat=({0} tài liệu)}"
                                                         Foreground="{StaticResource MutedTextBrush}" FontWeight="Normal" />
                                                </TextBlock>
                                            </Border>

                                            <!-- Material rows -->
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                            <Grid Margin="14,9">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="200" />
                                                                    <ColumnDefinition Width="160" />
                                                                    <ColumnDefinition Width="130" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding AuthorDisplay}" TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Publisher}" TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                                                <Grid Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <!-- File auto-download (uploaded file / .zip / FLM download): nút xanh -->
                                                                    <Button Content="Tải xuống"
                                                                            Style="{StaticResource SmallActionButtonStyle}"
                                                                            Visibility="{Binding IsDirectDownload, Converter={StaticResource BoolToVis}}"
                                                                            Command="{Binding DataContext.DownloadCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}" />
                                                                    <!-- Link trỏ web khác: "Xem tài liệu" gạch chân -->
                                                                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                                                                            Cursor="Hand" HorizontalAlignment="Left"
                                                                            Visibility="{Binding IsWebLink, Converter={StaticResource BoolToVis}}"
                                                                            Command="{Binding DataContext.DownloadCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}">
                                                                        <TextBlock Text="Xem tài liệu" TextDecorations="Underline"
                                                                                   Foreground="#2E6FD6" FontWeight="SemiBold" />
                                                                    </Button>
                                                                    <!-- Không có link: dấu gạch mờ -->
                                                                    <TextBlock Text="—" Foreground="{StaticResource MutedTextBrush}"
                                                                               Visibility="{Binding HasNoAction, Converter={StaticResource BoolToVis}}" />
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <TextBlock Text="Không tìm thấy tài liệu nào phù hợp."
                               Style="{StaticResource PageSubtitleStyle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Upload modal (admin only) -->
        <Border Style="{StaticResource ModalOverlayStyle}"
                Visibility="{Binding IsUploadPanelOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModalPanelStyle}" Width="520" MaxHeight="560"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Tải lên tài liệu" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />

                    <TextBlock Text="Tệp" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource CatalogTextBoxStyle}"
                                 IsReadOnly="True" VerticalAlignment="Center"
                                 Text="{Binding UploadFilePath, Mode=OneWay}"
                                 materialDesign:HintAssist.Hint="Chưa chọn tệp" />
                        <Button Grid.Column="2" Content="Chọn tệp..." Command="{Binding PickFileCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                    </Grid>

                    <TextBlock Text="Tiêu đề" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource CatalogTextBoxStyle}" Margin="0,0,0,12"
                             Text="{Binding UploadTitle, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Danh mục" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Style="{StaticResource CatalogComboBoxStyle}" Margin="0,0,0,12"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding UploadCategory}" />

                    <TextBlock Text="Môn học" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Style="{StaticResource CatalogComboBoxStyle}" Margin="0,0,0,18"
                              ItemsSource="{Binding UploadSubjects}"
                              SelectedItem="{Binding UploadSubject}"
                              DisplayMemberPath="Display"
                              materialDesign:HintAssist.Hint="Chọn môn học" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy" Command="{Binding CloseUploadPanelCommand}"
                                Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="Tải lên" Command="{Binding UploadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
