<UserControl x:Class="App.Views.Grades.TranscriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Transcript" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0">
                        <Run Text="{Binding Transcript.StudentCode, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="{Binding Transcript.FullName, Mode=OneWay, StringFormat= — {0}}" />
                        <Run Text="{Binding Transcript.MajorName, Mode=OneWay, StringFormat= • {0}}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right">
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}"
                            Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" />
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}">
                        <Run Text="GPA tích lũy: " />
                        <Run Text="{Binding CumulativeGpaDisplay, Mode=OneWay}" FontWeight="ExtraBold" />
                        <Run Text="{Binding EarnedCredits, Mode=OneWay, StringFormat= • {0} tín chỉ hoàn thành}" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource ErrorBannerStyle}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Semesters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SemesterCode}" FontSize="17"
                                                           FontWeight="ExtraBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding SemesterName, StringFormat= — {0}}"
                                                           FontSize="15" Foreground="{StaticResource MutedTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Foreground="{StaticResource MutedTextBrush}">
                                                <Run Text="GPA kỳ: " />
                                                <Run Text="{Binding SemesterGpa, Mode=OneWay, StringFormat={}{0:0.00}, TargetNullValue=-}"
                                                     FontWeight="ExtraBold" />
                                                <Run Text="{Binding EarnedCredits, Mode=OneWay, StringFormat= • {0} tín chỉ đạt}" />
                                            </TextBlock>
                                        </Grid>

                                        <DataGrid ItemsSource="{Binding Items}"
                                                  Style="{StaticResource CatalogDataGridStyle}"
                                                  ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                                                  CellStyle="{StaticResource CatalogCellStyle}"
                                                  MaxHeight="260">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Mã môn" Binding="{Binding CourseCode}" Width="110" />
                                                <DataGridTextColumn Header="Tên môn" Binding="{Binding CourseName}" Width="*" />
                                                <DataGridTextColumn Header="TC" Binding="{Binding Credits}" Width="55" />
                                                <DataGridTextColumn Header="Tổng kết" Binding="{Binding FinalScoreDisplay, Mode=OneWay}" Width="90" />
                                                <DataGridTextColumn Header="Letter" Binding="{Binding LetterGrade, TargetNullValue=-}" Width="75" />
                                                <DataGridTextColumn Header="Grade point" Binding="{Binding GradePointDisplay, Mode=OneWay}" Width="100" />
                                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="105" />
                                                <DataGridTextColumn Header="Lần học" Binding="{Binding AttemptNo}" Width="75" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Chưa có dữ liệu transcript."
                           Style="{StaticResource PageSubtitleStyle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
