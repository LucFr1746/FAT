<UserControl x:Class="App.Views.Grades.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24">
                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Statistics" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Tổng hợp kết quả, tín chỉ và tiến độ từ dữ liệu học tập hiện có."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>

                <Border Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <UniformGrid Columns="5" Margin="0,0,0,14">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="GPA tích lũy" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding GpaDisplay}" FontSize="24" FontWeight="ExtraBold"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="Tổng số môn" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding Dashboard.TotalCourses}" FontSize="24" FontWeight="ExtraBold"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="Passed / Failed" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextBrush}">
                                <Run Text="{Binding Dashboard.PassedCourses, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Dashboard.FailedCourses, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="Đang học" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding Dashboard.StudyingCourses}" FontSize="24" FontWeight="ExtraBold"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Điểm trung bình" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding AverageScoreDisplay}" FontSize="24" FontWeight="ExtraBold"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Columns="5" Margin="0,0,0,14">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="Tổng tín chỉ" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding Dashboard.RequiredCredits}" FontSize="22" FontWeight="ExtraBold"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="Đã hoàn thành" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding Dashboard.EarnedCredits}" FontSize="22" FontWeight="ExtraBold"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="Chưa hoàn thành" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding Dashboard.RemainingCredits}" FontSize="22" FontWeight="ExtraBold"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="Môn cao nhất" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding HighestCourseDisplay}" FontSize="17" FontWeight="ExtraBold"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Môn thấp nhất" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding LowestCourseDisplay}" FontSize="17" FontWeight="ExtraBold"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Tiến độ chương trình" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}">
                                <Run Text="{Binding Dashboard.EarnedCredits, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Dashboard.RequiredCredits, Mode=OneWay}" />
                                <Run Text="{Binding Dashboard.GraduationPercent, Mode=OneWay, StringFormat= • {0:0.0}%}" />
                            </TextBlock>
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Height="16"
                                     Value="{Binding Dashboard.GraduationPercent}" />
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="GPA từng học kỳ" Style="{StaticResource SectionTitleStyle}" />
                            <lvc:CartesianChart Series="{Binding GpaSeries}"
                                                XAxes="{Binding GpaXAxes}"
                                                YAxes="{Binding GpaYAxes}"
                                                Height="280" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Phân bố trạng thái" Style="{StaticResource SectionTitleStyle}" />
                            <lvc:PieChart Series="{Binding StatusSeries}" Height="210" />
                            <DataGrid ItemsSource="{Binding StatusDistribution}"
                                      Style="{StaticResource CatalogDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                                      CellStyle="{StaticResource CatalogCellStyle}"
                                      MaxHeight="170">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="*" />
                                    <DataGridTextColumn Header="Số môn" Binding="{Binding Count}" Width="75" />
                                    <DataGridTextColumn Header="Tỷ lệ"
                                                        Binding="{Binding Percent, StringFormat={}{0:0.0}%}"
                                                        Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Chưa có dữ liệu học tập để thống kê."
                           Style="{StaticResource PageSubtitleStyle}" Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
