<UserControl x:Class="App.Views.Grades.GradeEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Manage Grades" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Thêm, sửa hoặc xóa điểm trên các assessment đã có trong hệ thống."
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="Làm mới" Command="{Binding RefreshCommand}"
                        Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <StackPanel Grid.Row="1">
                <Border Style="{StaticResource StatusBannerStyle}"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}" />
                </Border>
                <Border Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Chọn môn và assessment"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding Terms}"
                                  SelectedItem="{Binding SelectedTerm}"
                                  DisplayMemberPath="Display"
                                  Style="{StaticResource CatalogComboBoxStyle}"
                                  Margin="0,0,0,10" />
                        <ComboBox Grid.Row="2" ItemsSource="{Binding Courses}"
                                  SelectedItem="{Binding SelectedCourse}"
                                  Style="{StaticResource CatalogComboBoxStyle}" Margin="0,0,0,14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding CourseCode, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text="{Binding CourseName, Mode=OneWay, StringFormat= — {0}}" />
                                        <Run Text="{Binding TermAndSemesterDisplay, Mode=OneWay, StringFormat= ({0})}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <DataGrid Grid.Row="3" ItemsSource="{Binding Assessments}"
                                  SelectedItem="{Binding SelectedAssessment}"
                                  Style="{StaticResource CatalogDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                                  CellStyle="{StaticResource CatalogCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Assessment" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Trọng số"
                                                    Binding="{Binding WeightPercent, Mode=OneWay, StringFormat={}{0:0.##}%}"
                                                    Width="105" />
                                <DataGridTextColumn Header="Điểm" Binding="{Binding ScoreDisplay, Mode=OneWay}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding EditModeLabel}" Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock Text="Môn học" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding SelectedCourse.CourseCode, TargetNullValue=-}"
                                   FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />

                        <TextBlock Text="Assessment" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding SelectedAssessment.Name, TargetNullValue=-}"
                                   FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Trọng số" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding SelectedAssessment.WeightPercent, StringFormat={}{0:0.##}%}"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />

                        <TextBlock Text="Học kỳ thực tế" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Semesters}"
                                  SelectedItem="{Binding SelectedSemester}"
                                  DisplayMemberPath="Display"
                                  IsEnabled="{Binding SelectedCourse.CanChooseSemester}"
                                  Style="{StaticResource CatalogComboBoxStyle}"
                                  Margin="0,0,0,6" />
                        <TextBlock Text="Chọn học kỳ khi nhập điểm lần đầu cho môn chưa đăng ký."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="Điểm (0–10)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ScoreText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CatalogTextBoxStyle}"
                                 materialDesign:HintAssist.Hint="Nhập điểm" Margin="0,0,0,18" />

                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Hủy" Command="{Binding CancelCommand}"
                                    Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,8" />
                            <Button Content="Xóa" Command="{Binding DeleteCommand}"
                                    IsEnabled="{Binding CanDeleteSelected}"
                                    Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,8" />
                            <Button Content="Lưu thay đổi" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Grid.ColumnSpan="3"
                           Text="Không có môn học nào có thể quản lý điểm."
                           Style="{StaticResource PageSubtitleStyle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasCourses, Converter={StaticResource InverseBoolToVisConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
