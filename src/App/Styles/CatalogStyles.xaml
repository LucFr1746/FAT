<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Shared look for the catalog admin and student curriculum screens.

        Extracted rather than repeated: the auth screens each carry ~150 lines of
        near-identical style definitions, and the eight screens added here would
        have multiplied that. One dictionary means a colour changes in one place.

        The palette matches the existing views exactly, so the new screens do not
        look bolted on:
          #FAF6EE surface   #E5DDCB border    #473C33 text     #7C6E65 muted
          #ABC270 primary   #FDA769 secondary #D9534F danger   #FEC868 accent
    -->

    <!-- ===================== Palette ===================== -->
    <Color x:Key="SurfaceColor">#FAF6EE</Color>
    <Color x:Key="BorderColor">#E5DDCB</Color>
    <Color x:Key="TextColor">#473C33</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAF6EE" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E5DDCB" />
    <SolidColorBrush x:Key="TextBrush" Color="#473C33" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7C6E65" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#ABC270" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#9AB160" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#FDA769" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#F59450" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D9534F" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#C43F3B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FEC868" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#EAF3DC" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FBE6E5" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#FFF4E0" />

    <sys:Double x:Key="CardRadius">14</sys:Double>

    <!-- ===================== Typography ===================== -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- ===================== Inputs ===================== -->
    <Style x:Key="CatalogTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Multi-line variant: descriptions and notes need room and wrapping. -->
    <Style x:Key="CatalogMultilineTextBoxStyle" TargetType="TextBox"
           BasedOn="{StaticResource CatalogTextBoxStyle}">
        <Setter Property="MinHeight" Value="90" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- Search box variant -->
    <Style x:Key="CatalogSearchBoxStyle" TargetType="TextBox"
           BasedOn="{StaticResource CatalogTextBoxStyle}">
        <Setter Property="MinHeight" Value="38" />
    </Style>

    <Style x:Key="CatalogComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="CatalogCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ===================== Buttons ===================== -->
    <Style x:Key="CatalogButtonBaseStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- A disabled button must LOOK disabled; without this the
                             user keeps clicking a control that will never respond. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CatalogButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CatalogButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SecondaryHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource CatalogButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource CatalogButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmallActionButtonStyle" TargetType="Button" BasedOn="{StaticResource CatalogButtonBaseStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    </Style>

    <!-- ===================== Cards & banners ===================== -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="StatusBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="ErrorBannerStyle" TargetType="Border" BasedOn="{StaticResource StatusBannerStyle}">
        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
    </Style>

    <Style x:Key="InfoBannerStyle" TargetType="Border" BasedOn="{StaticResource StatusBannerStyle}">
        <Setter Property="Background" Value="{StaticResource InfoBackgroundBrush}" />
    </Style>

    <!-- ===================== DataGrid ===================== -->
    <Style x:Key="CatalogDataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="RowHeight" Value="42" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="CatalogColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,10" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style x:Key="CatalogCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Modal ===================== -->
    <Style x:Key="ModalOverlayStyle" TargetType="Border">
        <Setter Property="Background" Value="#66000000" />
    </Style>

    <Style x:Key="ModalPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="MinWidth" Value="460" />
        <Setter Property="MaxWidth" Value="720" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== Chips ===================== -->
    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <Style x:Key="ChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

</ResourceDictionary>
