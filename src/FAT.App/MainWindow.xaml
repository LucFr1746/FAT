<Window x:Class="FAT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:FAT.App.ViewModels"
        xmlns:gradeVm="clr-namespace:FAT.App.ViewModels.GradeGpa"
        xmlns:gradeViews="clr-namespace:FAT.App.Views.GradeGpa"
        Title="FAT - FPT Academic Tracker" Height="800" Width="1280"
        MinHeight="650" MinWidth="1000" WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="#F7F8FC" FontFamily="{materialDesign:MaterialDesignFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate DataType="{x:Type gradeVm:GradeListViewModel}"><gradeViews:GradeListView /></DataTemplate>
        <DataTemplate DataType="{x:Type gradeVm:GradeEntryViewModel}"><gradeViews:GradeEntryView /></DataTemplate>
        <DataTemplate DataType="{x:Type gradeVm:GpaCalculatorViewModel}"><gradeViews:GpaCalculatorView /></DataTemplate>
        <DataTemplate DataType="{x:Type gradeVm:TranscriptViewModel}"><gradeViews:TranscriptView /></DataTemplate>
        <DataTemplate DataType="{x:Type gradeVm:StatisticsViewModel}"><gradeViews:StatisticsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="#302B63"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="8,10,8,24"><materialDesign:PackIcon Kind="School" Width="38" Height="38" Foreground="White"/><TextBlock Text="FAT" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="Academic Tracker" Foreground="#C9C5E8"/></StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding MenuItems}" SelectedItem="{Binding SelectedItem}" Background="Transparent" BorderThickness="0" DisplayMemberPath="Title" Foreground="White" FontSize="15"/>
                <StackPanel Grid.Row="2"><TextBlock Text="{Binding UserDisplayName}" Foreground="White" Margin="8" TextWrapping="Wrap"/><Button Content="Sign out" Command="{Binding LogoutCommand}" Margin="4"/></StackPanel>
            </Grid></Border>
            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/></Grid.RowDefinitions><Border Background="White" BorderBrush="#E5E5EF" BorderThickness="0,0,0,1"><DockPanel Margin="20,0"><Button Content="Back" Command="{Binding GoBackCommand}" DockPanel.Dock="Left"/><TextBlock Text="Academic workspace" VerticalAlignment="Center" FontSize="18" Margin="16,0"/></DockPanel></Border><ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/></Grid>
        </Grid>

        <Border Width="420" Padding="36" Background="White" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsAuthenticated}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel><materialDesign:PackIcon Kind="School" Width="56" Height="56" HorizontalAlignment="Center" Foreground="#5E35B1"/><TextBlock Text="FAT Academic Tracker" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,24"/><TextBlock Text="Username"/><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/><TextBlock Text="Password"/><PasswordBox x:Name="LoginPassword" Margin="0,4,0,18"/><Button Content="Sign in" Click="LoginClick" Height="42"/><TextBlock Text="{Binding LoginError}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="Demo: student01 / Student@123" Opacity="0.55" HorizontalAlignment="Center" Margin="0,18,0,0"/></StackPanel>
        </Border>
    </Grid>
</Window>
