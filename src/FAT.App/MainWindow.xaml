<Window x:Class="FAT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="FAT - FPT Academic Tracker"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <!--
        Placeholder shell. The navigation rail and the ContentControl host are
        added in the shell work item; each module then contributes its own
        NavigationItem entries rather than editing this file.
    -->
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <materialDesign:PackIcon Kind="School" Width="72" Height="72"
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
            <TextBlock Text="FAT - FPT Academic Tracker"
                       Margin="0,16,0,4"
                       HorizontalAlignment="Center"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
            <TextBlock Text="Database connection verified. Shell under construction."
                       HorizontalAlignment="Center"
                       Opacity="0.6"
                       Style="{StaticResource MaterialDesignBody2TextBlock}" />
        </StackPanel>
    </Grid>
</Window>
