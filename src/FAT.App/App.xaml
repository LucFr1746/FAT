<Application x:Class="FAT.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!--
        StartupUri is deliberately absent: the first window is created through
        the DI container in App.xaml.cs so that it receives its dependencies.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" xmlns:converters="clr-namespace:FAT.App.Converters"/>

            <!-- ViewModel to View Mappings -->
            <DataTemplate DataType="{x:Type vmAuth:LoginViewModel}" xmlns:vmAuth="clr-namespace:FAT.App.ViewModels.Auth" xmlns:vAuth="clr-namespace:FAT.App.Views.Auth">
                <vAuth:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAuth:RegisterViewModel}" xmlns:vmAuth="clr-namespace:FAT.App.ViewModels.Auth" xmlns:vAuth="clr-namespace:FAT.App.Views.Auth">
                <vAuth:RegisterView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vmAuth:ProfileViewModel}" xmlns:vmAuth="clr-namespace:FAT.App.ViewModels.Auth" xmlns:vAuth="clr-namespace:FAT.App.Views.Auth">
                <vAuth:ProfileView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAuth:ChangePasswordViewModel}" xmlns:vmAuth="clr-namespace:FAT.App.ViewModels.Auth" xmlns:vAuth="clr-namespace:FAT.App.Views.Auth">
                <vAuth:ChangePasswordView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAuth:UserManagementViewModel}" xmlns:vmAuth="clr-namespace:FAT.App.ViewModels.Auth" xmlns:vAuth="clr-namespace:FAT.App.Views.Auth">
                <vAuth:UserManagementView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}" xmlns:vm="clr-namespace:FAT.App.ViewModels" xmlns:v="clr-namespace:FAT.App.Views">
                <v:DashboardView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

