<UserControl x:Class="FAT.App.Views.Catalog.FlmImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource SurfaceBrush}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Import Dữ Liệu Chương Trình Học (FLM)" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"
                           Text="Nhập ngành, môn học, tín chỉ, GPA, môn tiên quyết, cấu trúc điểm, tài liệu và lịch kiểm tra từ tệp Excel hoặc thư mục CSV đã crawl từ FLM. Chạy lại nhiều lần vẫn an toàn: dữ liệu đã có sẽ được cập nhật chứ không tạo bản sao." />
            </StackPanel>

            <!-- Source -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="1. Chọn nguồn dữ liệu" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="Đường dẫn" Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,4" />
                    <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CatalogTextBoxStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Chọn tệp Excel (.xlsx)" Command="{Binding BrowseWorkbookCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Chọn thư mục CSV" Command="{Binding BrowseCsvFolderCommand}"
                                Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
                        <Button Content="Xem trước" Command="{Binding PreviewCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="16,0,0,0" MinWidth="140" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Options -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="2. Tùy chọn import" Style="{StaticResource SectionTitleStyle}" />
                    <CheckBox Content="Cập nhật dữ liệu đã tồn tại (bỏ chọn nếu muốn giữ nguyên chỉnh sửa thủ công)"
                              IsChecked="{Binding UpdateExisting}" Style="{StaticResource CatalogCheckBoxStyle}"
                              Margin="0,6,0,0" />
                    <CheckBox Content="Import cấu trúc điểm (bảng điểm thành phần)"
                              IsChecked="{Binding ImportAssessments}" Style="{StaticResource CatalogCheckBoxStyle}"
                              Margin="0,8,0,0" />
                    <CheckBox Content="Import tài liệu môn học" IsChecked="{Binding ImportMaterials}"
                              Style="{StaticResource CatalogCheckBoxStyle}" Margin="0,8,0,0" />
                    <CheckBox Content="Import lịch kiểm tra dự kiến" IsChecked="{Binding ImportSchedules}"
                              Style="{StaticResource CatalogCheckBoxStyle}" Margin="0,8,0,0" />
                    <CheckBox Content="Phân tích môn tiên quyết từ mô tả nguyên văn"
                              IsChecked="{Binding ImportPrerequisites}" Style="{StaticResource CatalogCheckBoxStyle}"
                              Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Banners -->
            <StackPanel Grid.Row="3">
                <Border Style="{StaticResource StatusBannerStyle}"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}"
                               FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
                <Border Background="#CCFFFFFF" Padding="14"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="6" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="Đang xử lý dữ liệu, vui lòng đợi..."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Preview -->
            <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14"
                    Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="3. Xem trước dữ liệu sẽ được nhập" Style="{StaticResource SectionTitleStyle}" />

                    <UniformGrid Columns="3" Margin="0,6,0,0">
                        <StackPanel Margin="0,6,12,6">
                            <TextBlock Text="Nguồn" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding Preview.SourceName}" FontWeight="ExtraBold" FontSize="15"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <StackPanel Margin="0,6,12,6">
                            <TextBlock Text="Số ngành" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding Preview.MajorCount}" FontWeight="ExtraBold" FontSize="15"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <StackPanel Margin="0,6,12,6">
                            <TextBlock Text="Số môn học" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding Preview.SubjectCount}" FontWeight="ExtraBold" FontSize="15"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <StackPanel Margin="0,6,12,6">
                            <TextBlock Text="Dòng chương trình học" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding Preview.CurriculumLinkCount}" FontWeight="ExtraBold"
                                       FontSize="15" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <StackPanel Margin="0,6,12,6">
                            <TextBlock Text="Cột điểm" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding Preview.AssessmentCount}" FontWeight="ExtraBold" FontSize="15"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <StackPanel Margin="0,6,12,6">
                            <TextBlock Text="Tài liệu / Lịch KT" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock FontWeight="ExtraBold" FontSize="15" Foreground="{StaticResource TextBrush}">
                                <Run Text="{Binding Preview.MaterialCount, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Preview.ScheduleCount, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>

                    <Button Content="▶ Bắt đầu Import" Command="{Binding ImportCommand}"
                            IsEnabled="{Binding CanImport}"
                            Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"
                            MinWidth="200" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- Result + warnings -->
            <StackPanel Grid.Row="5">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="4. Kết quả import" Style="{StaticResource SectionTitleStyle}" />

                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4">
                                <Run Text="Ngành - tạo mới:" />
                                <Run Text="{Binding Result.Majors.Created, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=", cập nhật:" />
                                <Run Text="{Binding Result.Majors.Updated, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4">
                                <Run Text="Môn học - tạo mới:" />
                                <Run Text="{Binding Result.Subjects.Created, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=", cập nhật:" />
                                <Run Text="{Binding Result.Subjects.Updated, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4">
                                <Run Text="Chương trình học - tạo mới:" />
                                <Run Text="{Binding Result.CurriculumLinks.Created, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=", cập nhật:" />
                                <Run Text="{Binding Result.CurriculumLinks.Updated, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4">
                                <Run Text="Cột điểm - tạo mới:" />
                                <Run Text="{Binding Result.Assessments.Created, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=", cập nhật:" />
                                <Run Text="{Binding Result.Assessments.Updated, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4">
                                <Run Text="Tài liệu - tạo mới:" />
                                <Run Text="{Binding Result.Materials.Created, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4">
                                <Run Text="Lịch kiểm tra - tạo mới:" />
                                <Run Text="{Binding Result.Schedules.Created, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4">
                                <Run Text="Môn tiên quyết - tạo mới:" />
                                <Run Text="{Binding Result.Prerequisites.Created, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,10,0,0"
                                   Text="Chạy lại lần thứ hai với cùng tệp phải cho 'tạo mới = 0' ở mọi mục - đó là dấu hiệu import không nhân bản dữ liệu." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Cảnh báo" Style="{StaticResource SectionTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding Warnings}" MaxHeight="260">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource PageSubtitleStyle}"
                                               Margin="0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
