<UserControl x:Class="FAT.App.Views.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="880" d:DesignWidth="1050"
             Background="#FFFFFF">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEC868"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#F5B94C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="18,0,18,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#ABC270"/>
                                <Setter Property="Background" TargetName="border" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#EFE8DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="18,0,18,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#ABC270"/>
                                <Setter Property="Background" TargetName="border" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,30">
                <Border Width="520" Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="24" Padding="40">
                    <Border.Effect>
                        <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="10" BlurRadius="32" Opacity="0.08"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Header with Graduation Cap Logo -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Border Width="44" Height="44" CornerRadius="22" Background="#ABC270" Margin="0,0,10,0">
                                    <Path Data="M12 3L1 9L12 15L21 10.09V17H23V9M5 13.18V17.18C5 17.18 8 20 12 20C16 20 19 17.18 19 17.18V13.18L12 17.09L5 13.18Z" 
                                          Fill="#FFFFFF" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ĐĂNG KÝ TÀI KHOẢN" FontSize="26" FontWeight="ExtraBold" Foreground="#473C33" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Hoàn tất hồ sơ Sinh viên để vào hệ thống FAT" FontSize="13" FontWeight="SemiBold" Foreground="#7C6E65" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Error Message Banner -->
                        <Border Background="#FFF3EB" BorderBrush="#FDA769" BorderThickness="1.5" CornerRadius="12" Padding="14" Margin="0,0,0,20"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C85210" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                <Button Command="{Binding NavigateToLoginCommand}" Content="➔ Quay lại màn hình Đăng Nhập" 
                                        Visibility="{Binding IsAccountAlreadyExists, Converter={StaticResource BoolToVisConverter}}"
                                        Background="Transparent" Foreground="#473C33" FontWeight="ExtraBold" FontSize="13" BorderThickness="0" Cursor="Hand" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Student Code -->
                        <TextBlock Text="Mã số Sinh viên *" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding StudentCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                        <!-- Full Name -->
                        <TextBlock Text="Họ và Tên *" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                        <!-- Email (Readonly if from Google) -->
                        <TextBlock Text="Email (Tài khoản) *" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEmailReadOnly}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                        <!-- Faculty -->
                        <TextBlock Text="Khoa / Chuyên ngành" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Faculty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                        <!-- Phone Number -->
                        <TextBlock Text="Số điện thoại" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                        <!-- Password Fields -->
                        <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="TxtPassword" PasswordChanged="TxtPassword_PasswordChanged" Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,16"/>

                        <TextBlock Text="Xác nhận mật khẩu" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="TxtConfirmPassword" PasswordChanged="TxtConfirmPassword_PasswordChanged" Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,20"/>

                        <!-- Accept Terms Checkbox -->
                        <CheckBox IsChecked="{Binding AcceptTerms}" Margin="0,0,0,24">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#473C33">
                                Tôi đồng ý với <Run Text="Điều khoản sử dụng" Foreground="#473C33" FontWeight="ExtraBold"/> và quy chế sinh viên FPT.
                            </TextBlock>
                        </CheckBox>

                        <!-- Submit Button -->
                        <Button Command="{Binding RegisterCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,20">
                            <Grid>
                                <TextBlock Text="Hoàn Tất Đăng Ký" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                                    <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0" Foreground="#473C33"/>
                                    <TextBlock Text="Đang xử lý..." FontWeight="ExtraBold"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Back to Login Link -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Đã có tài khoản? " Foreground="#7C6E65" FontSize="13" FontWeight="SemiBold"/>
                            <Button Command="{Binding NavigateToLoginCommand}" Content="Đăng nhập ngay" Background="Transparent" Foreground="#473C33" FontWeight="ExtraBold" FontSize="13" BorderThickness="0" Cursor="Hand" Padding="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
