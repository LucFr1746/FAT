<UserControl x:Class="FAT.App.Views.Auth.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="18,0,18,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#ABC270"/>
                                <Setter Property="Background" TargetName="border" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" TargetName="border" Value="#EFE8DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DatePicker Style -->
        <Style x:Key="ModernDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Action Warm Gold Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEC868"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#F5B94C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel Button Style -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#FAF6EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Border Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="24" Padding="36">
                <Border.Effect>
                    <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.06"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header Title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#FAF6EE" Margin="0,0,12,0">
                            <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HỒ SƠ CÁ NHÂN SINH VIÊN" FontSize="22" FontWeight="ExtraBold" Foreground="#473C33"/>
                            <TextBlock Text="Cập nhật thông tin học tập và lý lịch cá nhân" FontSize="12" Foreground="#7C6E65"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Success Status Message -->
                    <Border Background="#F4F8EB" BorderBrush="#ABC270" BorderThickness="1.5" CornerRadius="12" Padding="14" Margin="0,0,0,20"
                            Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅ " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#4B601C" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Error Message -->
                    <Border Background="#FFF3EB" BorderBrush="#FDA769" BorderThickness="1.5" CornerRadius="12" Padding="14" Margin="0,0,0,20"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C85210" FontSize="13" FontWeight="Bold"/>
                    </Border>

                    <!-- Profile Form Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <!-- Mã số Sinh viên (Read Only - Cố định) -->
                            <TextBlock Text="Mã số Sinh viên 🔒 (Không thể sửa)" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding StudentCode}" IsReadOnly="True" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20"/>

                            <!-- Họ và Tên (Read Only - Cố định) -->
                            <TextBlock Text="Họ và Tên Sinh viên 🔒 (Không thể sửa)" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding FullName}" IsReadOnly="True" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20"/>

                            <!-- Ngày tháng năm sinh (DatePicker format dd/MM/yyyy) -->
                            <TextBlock Text="Ngày tháng năm sinh *" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                            <DatePicker SelectedDate="{Binding DateOfBirth, Mode=TwoWay}" IsEnabled="{Binding IsEditMode}" Style="{StaticResource ModernDatePickerStyle}" Margin="0,0,0,20"/>
                        </StackPanel>

                        <!-- Right Column -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <!-- Email Liên hệ (Editable in Edit Mode) -->
                            <TextBlock Text="Email Liên hệ" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisConverter}}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20"/>

                            <!-- Ngành Học (Dropdown ComboBox) -->
                            <TextBlock Text="Ngành Học / Chuyên Ngành *" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Majors}" SelectedItem="{Binding SelectedMajor}" IsEnabled="{Binding IsEditMode}" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,20"/>

                            <!-- Kỳ Học Hiện Tại (Dropdown ComboBox Kỳ 1 -> Kỳ 9) -->
                            <TextBlock Text="Kỳ Học Hiện Tại *" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Semesters}" SelectedItem="{Binding SelectedSemester}" IsEnabled="{Binding IsEditMode}" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,20"/>
                        </StackPanel>
                    </Grid>

                    <!-- Action Buttons Section -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <!-- Cancel Edit Button (Shown ONLY in Edit Mode) -->
                        <Button Command="{Binding CancelEditCommand}" Content="❌ Hủy Bỏ" Style="{StaticResource CancelButtonStyle}" Margin="0,0,12,0"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}}"/>

                        <!-- View Mode Button: "✏️ Chỉnh Sửa Hồ Sơ" -->
                        <Button Command="{Binding EnableEditModeCommand}" Content="✏️ Chỉnh Sửa Hồ Sơ" Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisConverter}}"/>

                        <!-- Edit Mode Button: "💾 Lưu Thay Đổi Hồ Sơ" -->
                        <Button Command="{Binding SaveProfileCommand}" Content="💾 Lưu Thay Đổi Hồ Sơ" Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
