<UserControl x:Class="FAT.App.Views.Auth.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="750">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Modern PasswordBox Style -->
        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="18,0,18,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#ABC270"/>
                                <Setter Property="Background" TargetName="border" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Plaintext TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="18,0,18,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#ABC270"/>
                                <Setter Property="Background" TargetName="border" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEC868"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#F5B94C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Border Width="480" Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="24" Padding="32" HorizontalAlignment="Left">
                <Border.Effect>
                    <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.06"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="ĐỔI MẬT KHẨU TÀI KHOẢN" FontSize="22" FontWeight="ExtraBold" Foreground="#473C33" Margin="0,0,0,24"/>

                    <!-- Success Message Banner -->
                    <Border Background="#F4F8EB" BorderBrush="#ABC270" BorderThickness="1.5" CornerRadius="12" Padding="14" Margin="0,0,0,20"
                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#4B601C" FontSize="13" FontWeight="Bold"/>
                    </Border>

                    <!-- Formatted Red Error Message Banner (* Error Message) -->
                    <Border Background="#FFF3EB" BorderBrush="#FDA769" BorderThickness="1.5" CornerRadius="12" Padding="14" Margin="0,0,0,20"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C85210" FontSize="13" FontWeight="ExtraBold" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Field 1: Mật khẩu hiện tại -->
                    <TextBlock Text="Mật khẩu hiện tại *" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,18">
                        <PasswordBox x:Name="TxtCurrent" PasswordChanged="TxtCurrent_PasswordChanged" Style="{StaticResource ModernPasswordBoxStyle}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisConverter}}"/>
                        <TextBox x:Name="TxtCurrentPlain" Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" TextChanged="TxtCurrentPlain_TextChanged" Style="{StaticResource ModernTextBoxStyle}"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>

                    <!-- Field 2: Mật khẩu mới -->
                    <TextBlock Text="Mật khẩu mới *" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,18">
                        <PasswordBox x:Name="TxtNew" PasswordChanged="TxtNew_PasswordChanged" Style="{StaticResource ModernPasswordBoxStyle}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisConverter}}"/>
                        <TextBox x:Name="TxtNewPlain" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" TextChanged="TxtNewPlain_TextChanged" Style="{StaticResource ModernTextBoxStyle}"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>

                    <!-- Field 3: Xác nhận mật khẩu mới -->
                    <TextBlock Text="Xác nhận mật khẩu mới *" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <PasswordBox x:Name="TxtConfirm" PasswordChanged="TxtConfirm_PasswordChanged" Style="{StaticResource ModernPasswordBoxStyle}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisConverter}}"/>
                        <TextBox x:Name="TxtConfirmPlain" Text="{Binding ConfirmNewPassword, UpdateSourceTrigger=PropertyChanged}" TextChanged="TxtConfirmPlain_TextChanged" Style="{StaticResource ModernTextBoxStyle}"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>

                    <!-- Show Password Checkbox -->
                    <CheckBox Content="Hiển thị mật khẩu" IsChecked="{Binding IsPasswordVisible}" Foreground="#473C33" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,24"/>

                    <!-- Action Button -->
                    <Button Command="{Binding ChangePasswordCommand}" Content="🔑 Cập Nhật Mật Khẩu" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
