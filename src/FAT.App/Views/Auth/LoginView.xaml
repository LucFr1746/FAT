<UserControl x:Class="FAT.App.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1050"
             Background="#FFFFFF">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Primary Warm Gold Button Style (#FEC868) with 48px MinHeight -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEC868"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#F5B94C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" TargetName="border" Value="#E5DDCB"/>
                                <Setter Property="Foreground" Value="#A39688"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Google OAuth Button Style with 48px MinHeight -->
        <Style x:Key="GoogleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#FAF6EE"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#ABC270"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input TextBox Style with Direct Margin Indentation on ScrollViewer -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="18,0,18,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#ABC270"/>
                                <Setter Property="Background" TargetName="border" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern PasswordBox Style with Direct Margin Indentation on ScrollViewer -->
        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#FAF6EE"/>
            <Setter Property="Foreground" Value="#473C33"/>
            <Setter Property="BorderBrush" Value="#E5DDCB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="18,0,18,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#ABC270"/>
                                <Setter Property="Background" TargetName="border" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Background Ambient Radial Accents -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="450" Height="450" Canvas.Top="-150" Canvas.Right="-80">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#25ABC270" Offset="0"/>
                        <GradientStop Color="#00ABC270" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="350" Height="350" Canvas.Bottom="-80" Canvas.Left="-80">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#20FDA769" Offset="0"/>
                        <GradientStop Color="#00FDA769" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Main Content Center Card -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Border Width="460" Background="#FFFFFF" BorderBrush="#E5DDCB" BorderThickness="1.5" CornerRadius="24" Padding="40">
                    <Border.Effect>
                        <DropShadowEffect Color="#473C33" Direction="270" ShadowDepth="10" BlurRadius="32" Opacity="0.08"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- System Logo & Title Header (Graduation Cap / School Hat Logo) -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#ABC270" Margin="0,0,12,0">
                                    <!-- Graduation Cap / Mortarboard Icon -->
                                    <Path Data="M12 3L1 9L12 15L21 10.09V17H23V9M5 13.18V17.18C5 17.18 8 20 12 20C16 20 19 17.18 19 17.18V13.18L12 17.09L5 13.18Z" 
                                          Fill="#FFFFFF" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="FAT SYSTEM" FontSize="28" FontWeight="ExtraBold" Foreground="#473C33" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Hệ thống Quản lý Học tập &amp; Điểm Rèn luyện FPT" FontSize="13" FontWeight="SemiBold" Foreground="#7C6E65" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Error Message Banner -->
                        <Border Background="#FFF3EB" BorderBrush="#FDA769" BorderThickness="1.5" CornerRadius="12" Padding="14" Margin="0,0,0,20"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C85210" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Google OAuth Login Button -->
                        <Button Command="{Binding GoogleLoginCommand}" Style="{StaticResource GoogleButtonStyle}" Margin="0,0,0,22">
                            <StackPanel Orientation="Horizontal">
                                <!-- Google G Logo Icon -->
                                <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#4285F4" Data="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                        <Path Fill="#34A853" Data="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                        <Path Fill="#FBBC05" Data="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                        <Path Fill="#EA4335" Data="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Sign in with Google" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Divider "OR" -->
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" Fill="#E5DDCB"/>
                            <TextBlock Grid.Column="1" Text="hoặc đăng nhập bằng tài khoản" FontSize="12" FontWeight="SemiBold" Foreground="#7C6E65" Margin="14,0"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#E5DDCB"/>
                        </Grid>

                        <!-- Username / Email Input -->
                        <TextBlock Text="Tên đăng nhập / Email" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,18"/>

                        <!-- Password Input Container (Masked PasswordBox or Unmasked Plaintext TextBox) -->
                        <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="Bold" Foreground="#473C33" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18">
                            <!-- Masked PasswordBox (Shown when IsPasswordVisible is FALSE) -->
                            <PasswordBox x:Name="TxtPassword" 
                                         PasswordChanged="TxtPassword_PasswordChanged" 
                                         Style="{StaticResource ModernPasswordBoxStyle}" 
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisConverter}}"/>
                            
                            <!-- Plaintext TextBox (Shown when IsPasswordVisible is TRUE) -->
                            <TextBox x:Name="TxtPasswordPlain" 
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                                     TextChanged="TxtPasswordPlain_TextChanged" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisConverter}}"/>
                        </Grid>

                        <!-- Show Password CheckBox & Forgot Password Link -->
                        <Grid Margin="0,0,0,26">
                            <!-- CheckBox to Toggle Show Password -->
                            <CheckBox Content="Hiển thị mật khẩu" IsChecked="{Binding IsPasswordVisible}" Foreground="#473C33" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="Quên mật khẩu?" Foreground="#473C33" FontSize="13" FontWeight="ExtraBold" HorizontalAlignment="Right" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Login Button (#FEC868) -->
                        <Button Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,22">
                            <Grid>
                                <TextBlock Text="Đăng Nhập" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                                    <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0" Foreground="#473C33"/>
                                    <TextBlock Text="Đang xử lý..." FontWeight="ExtraBold"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Register Banner Highlight -->
                        <Border Background="#FAF6EE" BorderBrush="#E5DDCB" BorderThickness="1" CornerRadius="14" Padding="14" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Chưa có tài khoản? " Foreground="#7C6E65" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Command="{Binding NavigateToRegisterCommand}" Content="Đăng ký ngay" Background="Transparent" Foreground="#473C33" FontWeight="ExtraBold" FontSize="13" BorderThickness="0" Cursor="Hand" Padding="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
