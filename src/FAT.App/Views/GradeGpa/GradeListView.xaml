<UserControl x:Class="FAT.App.Views.GradeGpa.GradeListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F7F8FC">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <TextBlock Text="My Grades" FontSize="28" FontWeight="SemiBold" Foreground="#2D2859"/>
  <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#C62828" Margin="0,8"/>
  <DataGrid Grid.Row="2" Margin="0,18,0,0" ItemsSource="{Binding Semesters}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Semester" Binding="{Binding SemesterCode}"/><DataGridTextColumn Header="GPA" Binding="{Binding SemesterGpa, StringFormat=N2}"/><DataGridTextColumn Header="Earned credits" Binding="{Binding EarnedCredits}"/></DataGrid.Columns></DataGrid>
 </Grid>
</UserControl>
