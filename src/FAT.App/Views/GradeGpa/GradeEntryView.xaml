<UserControl x:Class="FAT.App.Views.GradeGpa.GradeEntryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F7F8FC">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <TextBlock Text="Manage Grades" FontSize="28" FontWeight="SemiBold" Foreground="#2D2859"/><TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#C62828" Margin="0,8"/>
  <Grid Grid.Row="2" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" DisplayMemberPath="Label"/><ComboBox Grid.Column="1" Margin="12,0" ItemsSource="{Binding Enrollments}" SelectedItem="{Binding SelectedEnrollment}" DisplayMemberPath="Label"/><TextBlock Grid.Column="2" Text="{Binding SelectedEnrollment.FinalScore, StringFormat='Final score: {0:N1}'}" VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Assessments}" SelectedItem="{Binding SelectedAssessment}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Assessment" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Weight" Binding="{Binding WeightLabel}"/><DataGridTextColumn Header="Minimum" Binding="{Binding MinimumScore}"/><DataGridTextColumn Header="Score" Binding="{Binding Score}"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="1" Margin="20,0"><TextBlock Text="Selected assessment"/><TextBlock Text="{Binding SelectedAssessment.Name}" FontSize="18" FontWeight="SemiBold"/><TextBox Text="{Binding Score}" Margin="0,14"/><Button Content="Save and recalculate" Command="{Binding SaveCommand}"/><TextBlock Text="{Binding SuccessMessage}" Foreground="#16845B" TextWrapping="Wrap" Margin="0,12"/></StackPanel></Grid>
 </Grid>
</UserControl>
