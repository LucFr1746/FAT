<UserControl x:Class="FAT.App.Views.GradeGpa.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="http://livecharts.com/schemas/v2"
             Background="#F7F8FC">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Academic Statistics"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#2D2859" />

        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="#C62828"
                   Margin="0,8" />

        <!-- Academic overview -->
        <Grid Grid.Row="2"
              Margin="0,8,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,8,0">

                <StackPanel>
                    <TextBlock Text="Cumulative GPA"
                               Opacity="0.65" />

                    <TextBlock Text="{Binding Dashboard.CumulativeGpa,
                                              TargetNullValue='—',
                                              StringFormat=N2}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#5E35B1" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="14"
                    Margin="8,0">

                <StackPanel>
                    <TextBlock Text="Earned credits"
                               Opacity="0.65" />

                    <TextBlock Text="{Binding Dashboard.EarnedCredits}"
                               FontSize="26"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="14"
                    Margin="8,0">

                <StackPanel>
                    <TextBlock Text="Graduation progress"
                               Opacity="0.65" />

                    <TextBlock Text="{Binding Dashboard.GraduationPercent,
                                              StringFormat='{}{0:N1}%'}"
                               FontSize="26"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Background="White"
                    CornerRadius="10"
                    Padding="14"
                    Margin="8,0,0,0">

                <StackPanel>
                    <TextBlock Text="Classification"
                               Opacity="0.65" />

                    <TextBlock Text="{Binding Dashboard.ClassificationName}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Charts -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,5,8,8">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="GPA trend"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="8,0,0,8" />

                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding GpaSeries}"
                                        XAxes="{Binding GpaXAxes}" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="12"
                    Margin="8,5,0,8">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Grade distribution"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="8,0,0,8" />

                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding DistributionSeries}"
                                        XAxes="{Binding DistributionXAxes}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Course highlights and warnings -->
        <Grid Grid.Row="4"
              Margin="0,8,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,8,0">

                <StackPanel>
                    <TextBlock Text="Top courses"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding TopCourses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock Text="{Binding FinalScore,
                                                              StringFormat=N1}"
                                               DockPanel.Dock="Right"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="{Binding CourseCode}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,8,0" />

                                    <TextBlock Text="{Binding CourseName}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="14"
                    Margin="8,0">

                <StackPanel>
                    <TextBlock Text="Needs attention"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding WeakestCourses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock Text="{Binding FinalScore,
                                                              StringFormat=N1}"
                                               DockPanel.Dock="Right"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="{Binding CourseCode}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,8,0" />

                                    <TextBlock Text="{Binding CourseName}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="14"
                    Margin="8,0,0,0">

                <StackPanel>
                    <TextBlock Text="Academic warnings"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding Dashboard.Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding SemesterCode}"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="{Binding Reason}"
                                               Foreground="#C62828"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>