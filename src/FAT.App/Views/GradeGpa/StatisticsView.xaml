<UserControl x:Class="FAT.App.Views.GradeGpa.StatisticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="http://livecharts.com/schemas/v2" Background="#F7F8FC">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Academic Statistics" FontSize="28" FontWeight="SemiBold" Foreground="#2D2859"/><TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#C62828" Margin="0,8"/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="10" Padding="12" Margin="0,5,8,8"><lvc:CartesianChart Series="{Binding GpaSeries}" XAxes="{Binding GpaXAxes}"/></Border><Border Grid.Column="1" Background="White" CornerRadius="10" Padding="12" Margin="8,5,0,8"><lvc:CartesianChart Series="{Binding DistributionSeries}" XAxes="{Binding DistributionXAxes}"/></Border></Grid>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Top courses" FontSize="18" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding TopCourses}" DisplayMemberPath="CourseName"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Needs attention" FontSize="18" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding WeakestCourses}" DisplayMemberPath="CourseName"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Warnings" FontSize="18" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Dashboard.Warnings}" DisplayMemberPath="Reason"/></StackPanel></Grid>
 </Grid>
</UserControl>
