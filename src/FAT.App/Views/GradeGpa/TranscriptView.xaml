<UserControl x:Class="FAT.App.Views.GradeGpa.TranscriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F8FC">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Student information -->
        <StackPanel>
            <TextBlock Text="Official Transcript"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#2D2859" />

            <StackPanel Orientation="Horizontal"
                        Margin="0,8,0,0">

                <TextBlock Text="{Binding Transcript.FullName,
                                          TargetNullValue='Loading...'}"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding Transcript.StudentCode,
                                          StringFormat=' · {0}'}"
                           FontSize="16"
                           Opacity="0.7" />
            </StackPanel>
        </StackPanel>

        <!-- Loading or database error -->
        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="#C62828"
                   Margin="0,8"
                   TextWrapping="Wrap" />

        <!-- Semester transcript -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Transcript.Semesters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Expander IsExpanded="True"
                                  Margin="0,5">

                            <Expander.Header>
                                <DockPanel>
                                    <TextBlock Text="{Binding SemesterName}"
                                               FontWeight="Bold"
                                               FontSize="16" />

                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal">

                                        <TextBlock Text="{Binding SemesterGpa,
                                                                  TargetNullValue='—',
                                                                  StringFormat=' · GPA {0:N2}'}" />

                                        <TextBlock Text="{Binding EarnedCredits,
                                                                  StringFormat=' · {0} credits'}" />
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>

                            <DataGrid ItemsSource="{Binding Items}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      Margin="0,8,0,12">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code"
                                                        Binding="{Binding CourseCode}" />

                                    <DataGridTextColumn Header="Course"
                                                        Binding="{Binding CourseName}"
                                                        Width="*" />

                                    <DataGridTextColumn Header="Credits"
                                                        Binding="{Binding Credits}" />

                                    <DataGridTextColumn Header="Score"
                                                        Binding="{Binding FinalScore,
                                                                          TargetNullValue='—',
                                                                          StringFormat=N1}" />

                                    <DataGridTextColumn Header="Grade"
                                                        Binding="{Binding LetterGrade,
                                                                          TargetNullValue='—'}" />

                                    <DataGridTextColumn Header="Status"
                                                        Binding="{Binding Status}" />

                                    <DataGridCheckBoxColumn Header="Counted"
                                                            Binding="{Binding IsCounted}" />

                                    <DataGridTextColumn Header="Attempt"
                                                        Binding="{Binding AttemptNo}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>