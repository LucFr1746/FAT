<Project Sdk="Microsoft.NET.Sdk">

  <!-- Presentation layer: WPF + MVVM. Binding only, no business logic. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      This MUST be net8.0-windows10.0.19041.0, NOT plain "net8.0-windows".
      "net8.0-windows" implicitly means net8.0-windows7.0, and
      SkiaSharp.Views.WPF (a LiveCharts2 dependency) only ships assets for
      net8.0-windows10.0.19041. Leave it at the default and NuGet silently falls
      back to the .NET Framework 4.6.2 assets (warning NU1701) and the charts
      blow up at runtime. Do not lower this line.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>FAT.App</RootNamespace>
    <AssemblyName>FAT.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="MaterialDesignThemes" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FAT.Domain\FAT.Domain.csproj" />
    <ProjectReference Include="..\FAT.Data\FAT.Data.csproj" />
    <ProjectReference Include="..\FAT.Services\FAT.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      appsettings.json IS committed (shared defaults).
      appsettings.Local.json is NOT - each developer overrides their own
      SQL Server instance there without disturbing anyone else.
    -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The FLM catalog export, copied next to the executable so the Import screen
      can offer it as the default without the user hunting for a path.
      Link= flattens the repository layout into a single Data folder in output.
    -->
    <None Include="..\..\db\data\**\*.*"
          Link="Data\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
