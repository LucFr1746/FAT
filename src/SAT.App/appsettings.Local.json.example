// ĐỔI TÊN file này thành "appsettings.Local.json" nếu SQL Server của bạn KHÔNG
// phải instance mặc định trên localhost.
//
// File appsettings.Local.json đã nằm trong .gitignore nên sẽ không bị commit -
// mỗi người giữ cấu hình riêng mà không đụng tới cấu hình của người khác.
//
// Các giá trị Server thường gặp:
//   localhost              instance mặc định (MSSQLSERVER)
//   .\SQLEXPRESS           SQL Server Express
//   (localdb)\MSSQLLocalDB LocalDB đi kèm Visual Studio
//
// Không chắc tên instance? Chạy lệnh:
//   sqlcmd -S localhost -E -C -Q "SELECT @@SERVERNAME"
{
  "ConnectionStrings": {
    "SatDatabase": "Server=.\\SQLEXPRESS;Database=SAT;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connect Timeout=10"
  }
}
