<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tầng trình bày: WPF + MVVM. Chỉ binding, không chứa business logic. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      PHẢI là net8.0-windows10.0.19041.0, KHÔNG dùng "net8.0-windows".
      "net8.0-windows" ngầm hiểu là net8.0-windows7.0, mà SkiaSharp.Views.WPF
      (phụ thuộc của LiveCharts2) chỉ ship assets cho net8.0-windows10.0.19041.
      Để mặc định thì NuGet rơi ngược về assets .NET Framework 4.6.2 (cảnh báo
      NU1701) và chart sẽ nổ lúc chạy. Đừng hạ dòng này xuống.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationIcon></ApplicationIcon>
    <RootNamespace>SAT.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="MaterialDesignThemes" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAT.Domain\SAT.Domain.csproj" />
    <ProjectReference Include="..\SAT.Data\SAT.Data.csproj" />
    <ProjectReference Include="..\SAT.Services\SAT.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      appsettings.json ĐƯỢC commit (giá trị mặc định dùng chung).
      appsettings.Local.json KHÔNG commit - mỗi người ghi đè instance của mình.
    -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

</Project>
